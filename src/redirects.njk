---
# Old addresses that have moved. GitHub Pages cannot redirect on the server, so each old address gets a small
# page that redirects at once (meta refresh), with a link for browsers that do not. Not in the sitemap or search.
pagination:
  data: redirects
  size: 1
  alias: redirect
permalink: "{{ redirect.from }}"
eleventyExcludeFromCollections: true
redirects:
  - from: /luftrom/
    to: /tarn/
---
<!doctype html>
<html lang="nb">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex">
<meta http-equiv="refresh" content="0; url={{ redirect.to | url }}">
<link rel="canonical" href="{{ site.url }}{{ redirect.to }}">
<title>Flyttet</title>
</head>
<body>
<p>Siden er flyttet til <a href="{{ redirect.to | url }}">{{ site.url }}{{ redirect.to }}</a>.</p>
</body>
</html>

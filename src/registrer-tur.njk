---
layout: base.njk
pagination:
  data: languages
  size: 1
  alias: language
permalink: "{{ '/registrer-tur/' | localeUrl(language.code) }}"
bodyClass: page-logflight
noindex: true
modules:
  - /assets/js/logbook-form.mjs
eleventyComputed:
  name: "{{ t.logFlight.title }}"
  description: "{{ t.logFlight.description }}"
---
{#- «Registrer tur» (prototype): a pilot logs a flight, from a log file (IGC or KML) read here in the browser with the
    same code as the logbook script (lib/igc.js as assets/js/igc.js; the track never leaves the browser), or typed in.
    Only the sums are sent to the data service (POST /v1/logbook, workers/data/src/logbook.js), with the Turnstile
    check as for «Meld fra». The sums for everyone are on /flyaktivitet/. Not in the menu and not indexed while it is a
    prototype; linked from /flyaktivitet/. -#}
{%- import "macros.njk" as m with context -%}
<main class="simple-page logflight-page">
  <header class="topbar">
    <a class="back-link" href="{{ '/flyaktivitet/' | localeUrl }}">{{ m.chevron("left") }}{{ t.activity.title }}</a>
    {{ m.siteMenu() }}
  </header>

  <div class="simple-page__intro" id="content" tabindex="-1">
    <p class="home__eyebrow">{{ t.home.eyebrow }}</p>
    <h1>{{ t.logFlight.title }}</h1>
    <p class="muted">{{ t.logFlight.intro }}</p>
    <p class="muted logflight__prototype">{{ t.logFlight.prototype }}</p>
  </div>

  {% if site.turnstileSiteKey %}
  <section class="block report" id="logflight" data-url="{{ site.logbookPostUrl }}" data-sitekey="{{ site.turnstileSiteKey }}" aria-label="{{ t.logFlight.title }}">
    <form class="report__form" id="logflight-form" novalidate>
      <label class="report__field">{{ t.logFlight.file }}
        <input type="file" name="file" accept=".igc,.kml,application/octet-stream,application/vnd.google-earth.kml+xml" aria-describedby="logflight-file-hint">
        <span class="muted report__hint" id="logflight-file-hint">{{ t.logFlight.fileHint }}</span>
      </label>
      <p class="report__status" id="logflight-found" role="status" aria-live="polite"></p>
      <label class="report__field">{{ t.logFlight.site }}
        <select name="site" required>
          <option value="">{{ t.logFlight.chooseSite }}</option>
          {% for s in collections.sites %}<option value="{{ s.data.id }}">{{ s.data.name }}</option>{% endfor %}
        </select>
      </label>
      <label class="report__field">{{ t.logFlight.date }}
        <input type="date" name="day" required>
      </label>
      <label class="report__field">{{ t.logFlight.minutes }}
        <input type="number" name="minutes" min="1" max="720" step="1" inputmode="numeric" required>
      </label>
      <label class="report__field">{{ t.logFlight.maxAlt }}
        <input type="number" name="maxAlt" min="0" max="6000" step="1" inputmode="numeric">
      </label>
      <label class="report__field">{{ t.logFlight.maxDist }}
        <input type="number" name="maxDistKm" min="0" max="500" step="0.1" inputmode="decimal">
      </label>
      <label class="report__field">{{ t.logFlight.category }}
        <select name="category">
          <option value="">{{ t.logFlight.categoryNone }}</option>
          <option value="PG">PG</option>
          <option value="SPG">SPG</option>
        </select>
      </label>
      <div class="report__check" id="logflight-check"></div>
      <button type="submit" class="btn report__send">{{ t.logFlight.send }}</button>
      <p class="report__status" id="logflight-status" role="status" aria-live="polite"></p>
      <p class="muted report__privacy">{{ t.logFlight.privacy }}</p>
    </form>
    <noscript><p>{{ t.logFlight.noScript }}</p></noscript>
  </section>
  {% else %}
  <p>{{ t.logFlight.notReady }}</p>
  {% endif %}
</main>
<script type="application/json" id="sites-data">{{ collections.sites | stationSites(lang) | json | safe }}</script>

---
# 3D-visning for steder med tegning (<id>-drawing.geojson, se lib/drawing.js). Prøveversjon:
# ikke i sitemap, og lenket bare fra oversiktsbildet på stedssiden.
layout: base.njk
bodyClass: page-3d
noindex: true
pagination:
  data: collections.sites3d
  size: 1
  alias: s
permalink: "/flysteder/{{ s.data.id }}/3d/"
styles:
  - /assets/maplibre/maplibre-gl.css
scripts:
  - /assets/maplibre/maplibre-gl.js
  - /assets/js/site3d.js
eleventyComputed:
  name: "{{ s.data.name }} i 3D"
  description: "{{ s.data.name }} i 3D med starter, landing, gangrute og det klubben har tegnet inn."
---
{%- import "macros.njk" as m with context -%}
{%- set d = s.data -%}
<div class="page-3d__wrap">
  <header class="topbar">
    <a class="back-link" href="{{ s.url }}">{{ m.chevron("left") }}{{ d.name }}</a>
    <span class="topbar__end">{{ m.siteMenu() }}</span>
  </header>

  <div class="page-3d__intro">
    <h1>{{ d.name }} i 3D {{ m.tag("Prøveversjon", "warning") }}</h1>
    <p class="muted">Den gule buen viser hvilke sider av fjellet stedet passer for. Dra for å flytte. Høyreklikk og dra, eller bruk to fingre, for å dreie og vippe. Trykk på en start eller et nummer for å lese mer.</p>
  </div>

  {#- UTKAST: to måter å vise retningsbuen på, så klubben kan prøve begge og velge. -#}
  {% if d.wind_directions.primary.length or d.wind_directions.possible.length %}
  <div class="filter map3d-mode">
    <span class="filter__title" id="arc-mode-title">Retningsbuen (utkast, velg den som er lettest å lese)</span>
    <div class="pills" role="group" aria-labelledby="arc-mode-title">
      <button type="button" class="pill" data-arc-mode="lifted" aria-pressed="true">Løftet over bakken</button>
      <button type="button" class="pill" data-arc-mode="ground" aria-pressed="false">På bakken</button>
    </div>
  </div>
  {% endif %}

  <div class="map3d-wrap">
    <div id="map3d" class="map3d" role="region" aria-label="3D-kart over {{ d.name }}"></div>
    <button type="button" class="btn btn--white map3d__reset" id="map3d-reset">Tilbakestill utsikt</button>
  </div>
  <section class="map3d-info" id="map3d-info" aria-live="polite" hidden></section>

  <ul class="map-legend" aria-label="Tegnforklaring">
    <li><span class="map3d__launch map3d__launch--legend"></span>Start (trykk for å lese mer)</li>
    {% if d.landings.length %}<li><span class="map-symbol map-symbol--landing"></span>Landing</li>{% endif %}
    {% if d.parking.length %}<li><span class="symbol symbol--parking">P</span>Parkering</li>{% endif %}
    {% if d.derived.routes.length %}<li><span class="symbol symbol--route"></span>Gangrute</li>{% endif %}
    <li><span class="symbol drawing-swatch drawing-swatch--arrow"></span>Retningene stedet passer for</li>
    {% if d.wind_directions.possible.length %}<li><span class="symbol drawing-swatch drawing-swatch--possible"></span>Mulig retning</li>{% endif %}
    {%- set styles = [] -%}
    {%- for f in d.derived.drawing.features %}{% if f.properties.kind == "label" %}{% if f.properties.style == "hazard" %}{% set styles = (styles.push("hazard-label"), styles) %}{% endif %}{% else %}{% set styles = (styles.push(f.properties.style or (f.properties.kind == "area" and "hazard") or "flight"), styles) %}{% endif %}{% endfor %}
    {% if "flight" in styles %}<li><span class="symbol drawing-swatch drawing-swatch--flight"></span>Flyvei</li>{% endif %}
    {% if "launch" in styles %}<li><span class="symbol drawing-swatch drawing-swatch--arrow"></span>Startkant</li>{% endif %}
    {% if "hazard" in styles %}<li><span class="symbol drawing-swatch drawing-swatch--hazard"></span>Fareområde</li>{% endif %}
    {% if "hazard-label" in styles %}<li><span class="drawing-pin drawing-pin--hazard drawing-pin--legend">!</span>Fare (nummer i rød firkant)</li>{% endif %}
  </ul>

  {#- Det samme som tekst, så det kan leses uten kartet og med skjermleser. -#}
  {#- Nummereringen er den samme som punktene i kartet (site3d.js): tekstene (label med title) i rekkefølge. -#}
  {%- set labels = [] -%}
  {%- for f in d.derived.drawing.features %}{% if f.properties.kind == "label" and f.properties.title %}{% set labels = (labels.push(f), labels) %}{% endif %}{% endfor %}
  {% if labels.length %}
  <section class="block" aria-labelledby="h-drawing">
    <h2 id="h-drawing">Punkter i kartet</h2>
    <ol class="drawing-list">
      {% for f in labels %}
      <li data-n="{{ loop.index }}">
        <button type="button" data-n="{{ loop.index }}" aria-label="Vis punkt {{ loop.index }} i kartet"><span class="drawing-pin{% if f.properties.style == 'hazard' %} drawing-pin--hazard{% endif %}">{{ loop.index }}</span></button>
        <div><strong>{{ f.properties.title }}</strong>{% if f.properties.text %}<span>{{ f.properties.text }}</span>{% endif %}</div>
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  <p class="map3d-edit-hint muted">Tegningen ligger i <code>{{ d.id }}-drawing.geojson</code> i stedets mappe. Legg til <code>?rediger</code> i adressen for å hente koordinater og utsnitt til den.</p>
  <p class="disclaimer">Opplysningene er veiledende, og hver pilot vurderer selv om stedet og forholdene er OK. Høyder: Terrain Tiles (AWS), som i Norge bygger på Kartverkets høydedata.</p>
</div>

<script type="application/json" id="site3d-data">{{ {
  name: d.name,
  launch: d.launch,
  launches: d.launches,
  wind_directions: d.wind_directions,
  landings: d.landings,
  parking: d.parking,
  routes: d.derived.routes,
  drawing: d.derived.drawing
} | json | safe }}</script>

---
layout: base.njk
permalink: /luftrom/
bodyClass: page-towers
name: Tårn
description: Telefonnumre til tårnene rundt HPGTs flysteder.
---
{#- Numrene ligger i src/_data/towers.json. Tårn uten nummer vises ikke. -#}
{%- import "macros.njk" as m with context -%}
<div class="towers-page">
  <header class="topbar">
    <a class="back-link" href="/">{{ m.chevron("left") }}Alle flysteder</a>
    {{ m.siteMenu() }}
  </header>

  <div class="towers-page__intro">
    <h1>Tårn</h1>
    <p class="muted">Ring tårnet når du skal fly i kontrollert luftrom. Sjekk alltid luftrom og NOTAM i <a href="https://ippc.no" target="_blank" rel="noopener">IPPC{{ m.external() }}</a> før du flyr.</p>
  </div>

  <ul class="towers">
    {% for tower in towers %}{% if tower.phone %}
    <li>
      <a class="big-btn" href="tel:{{ tower.phone | replace(' ', '') }}">
        <span><span class="towers__name">{{ tower.name }}</span><span class="towers__phone">{{ tower.phone }}</span></span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.4 1.8.7 2.7a2 2 0 01-.5 2.1L8 9.8a16 16 0 006 6l1.3-1.3a2 2 0 012.1-.4c.9.3 1.8.6 2.7.7a2 2 0 011.7 2z"></path></svg>
      </a>
    </li>
    {% endif %}{% endfor %}
  </ul>
</div>

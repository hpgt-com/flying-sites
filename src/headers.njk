permalink: /_headers
eleventyExcludeFromCollections: true
---
# Svarheadere for siden på Cloudflare (workers/site; GitHub Pages overser denne filen). Lages fra denne malen
# (src/headers.njk → _site/_headers). CSP-en er site.csp (src/_data/site.js), den samme som <meta> på hver side,
# pluss frame-ancestors, som en meta-tagg ikke kan sette, og hvor brudd rapporteres (report-uri for eldre nettlesere,
# report-to med Reporting-Endpoints for nyere; workers/data/src/csp-report.js). Som header dekker den også filer som
# ikke er HTML. Trusted Types håndheves (require-trusted-types-for, trusted-types): bare policyene i
# src/assets/js/trusted-types.js kan lages, og HTML og skriptadresser som ikke går gjennom dem, stoppes.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Reporting-Endpoints: csp="{{ site.cspReportUrl }}"
  Content-Security-Policy: {{ site.csp | safe }}; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types default fs-script-url; report-uri {{ site.cspReportUrl }}; report-to csp
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site

# Service workeren henter kartfliser og data fra andre verter (sw.js), og en CSP-header på skriptet til workeren ville
# styrt de hentingene (connect-src). CSP-en til sidene er for sidene, så workeren får ingen. Den kan bare lastes av
# sidene, fra denne opprinnelsen. Det samme gjelder rapporteringsendepunktet.
/sw.js
  ! Content-Security-Policy
  ! Reporting-Endpoints

# Bildene har en hash av innholdet i navnet (lib/images.js): et endret bilde får nytt navn.
/img/*
  Cache-Control: public, max-age=31536000, immutable

# Sidene ber om skriptene, stilarkene og skriftene med ?v=<hash>, men ikke alle (skrifter fra fonts.css, bildene til
# Leaflet), så én dag, ikke et år. GitHub Pages gir alt ti minutter.
/assets/*
  Cache-Control: public, max-age=86400

---
layout: base.njk
permalink: /status/
bodyClass: page-status
name: Status
noindex: true
---
{%- import "macros.njk" as m with context -%}
{%- set s = collections.sites | statusSummary -%}
<div class="status-page">
  <header class="topbar">
    <a class="back-link" href="/">{{ m.chevron("left") }}Alle flysteder</a>
  </header>

  <div class="status-page__intro">
    <h1>Status for flystedene</h1>
    <p class="muted">For dere som vedlikeholder siden. Lages automatisk fra stedsfilene ved hver bygging.</p>
  </div>

  <dl class="status-summary">
    <div><dt>Gjennomgått</dt><dd>{{ s.reviewed }} av {{ s.total }}</dd></div>
    <div><dt>Egen side</dt><dd>{{ s.withPage }} av {{ s.total }}</dd></div>
  </dl>

  {% if s.missingCounts.length %}
  <section class="status-missing" aria-labelledby="h-missing">
    <h2 id="h-missing">Mangler totalt</h2>
    <div class="tags">
      {% for c in s.missingCounts %}{{ m.tag(c.label ~ ": " ~ c.count) }}{% endfor %}
    </div>
  </section>
  {% endif %}

  <section aria-labelledby="h-sites">
    <h2 id="h-sites">Per sted</h2>
    <div class="status-table-wrap">
      <table class="status-table">
        <thead>
          <tr><th scope="col">Sted</th><th scope="col">Gjennomgått</th><th scope="col">Egen side</th><th scope="col">Mangler</th></tr>
        </thead>
        <tbody>
          {% for row in s.rows %}
          <tr>
            <th scope="row">{% if row.url %}<a href="{{ row.url }}">{{ row.name }}</a>{% else %}{{ row.name }}{% endif %}</th>
            <td data-label="Gjennomgått">{% if row.reviewed %}{{ row.reviewed.date | formatDate }}<span class="muted"> av {{ row.reviewed.by }}</span>{% else %}<strong class="danger">Nei</strong>{% endif %}</td>
            <td data-label="Egen side">{{ "Ja" if row.url else "Nei" }}</td>
            <td data-label="Mangler">{% if row.missing.length %}<span class="tags">{% for item in row.missing %}{{ m.tag(item, "missing") }}{% endfor %}</span>{% else %}<span class="muted">Ingenting</span>{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
</div>

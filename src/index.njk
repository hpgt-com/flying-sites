---
layout: base.njk
bodyClass: page-home
# One home page per language: / and /en/ (src/_data/languages.js).
pagination:
  data: languages
  size: 1
  alias: language
permalink: "{{ '/' | localeUrl(language.code) }}"
eleventyComputed:
  description: "{{ t.home.description }}"
scripts:
  - /assets/leaflet-markercluster/leaflet.markercluster.js
  - /assets/js/wind.js
  - /assets/js/home.js
---
{%- import "macros.njk" as m with context -%}
<div class="home">
  <div class="home__left">
    <header class="topbar">
      <span class="logo">{{ t.common.siteTitle }}</span>
      <div class="topbar__end">{{ m.siteMenu() }}</div>
    </header>

    <div class="home__intro">
      <h1>{{ t.home.title }}</h1>
    </div>

    {#- Tabs in the left column (home.js): Flysteder (search, filters, list), Vær and Info. The map is always shown. -#}
    <div class="home-tabs" role="tablist" aria-label="{{ t.home.tabsLabel }}">
      <button type="button" role="tab" id="tab-sites" aria-controls="pane-sites" aria-selected="true">{{ t.home.tabSites }}</button>
      <button type="button" role="tab" id="tab-weather" aria-controls="pane-weather" aria-selected="false" tabindex="-1">{{ t.home.tabWeather }}</button>
      <button type="button" role="tab" id="tab-info" aria-controls="pane-info" aria-selected="false" tabindex="-1">{{ t.home.tabInfo }}</button>
    </div>

    <div class="home-pane home-pane--sites" id="pane-sites" role="tabpanel" aria-labelledby="tab-sites">

    <div class="filters" id="filters">
      {#- Search by name. Filters the list and the map while typing (home.js). -#}
      <div class="filter filter--search" role="search">
        <label class="filter__title" for="site-search">{{ t.home.searchLabel }}</label>
        <input type="search" id="site-search" class="search-input" placeholder="{{ t.home.searchPlaceholder }}" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" aria-describedby="search-hits">
        {#- Matches right below the field, so they are visible while typing, also on mobile where the list is far down. -#}
        <div class="search-hits" id="search-hits" aria-live="polite" hidden></div>
      </div>
      {% if forecast %}
      <div class="filter">
        <span class="filter__title" id="f-wind">{{ t.home.windFromForecast }}</span>
        {#- Segmented control, so all the times fit on one row. -#}
        <div class="segmented" role="group" aria-labelledby="f-wind">
          {% for value, label, full in t.home.slots %}
          <button type="button" data-wind="{{ value }}" aria-pressed="{{ 'true' if value == '0' else 'false' }}"{% if full != label %} aria-label="{{ full }}" title="{{ full }}"{% endif %}>{{ label }}</button>
          {% endfor %}
        </div>
        {#- Toggle: dim sites where the forecast says «Passer ikke» or «For mye vind» (home.js). -#}
        <button type="button" class="suggest-switch" data-suggest aria-pressed="false">{{ t.home.suggest }}</button>
        <details class="wind-rules">
          <summary>{{ t.home.rulesSummary }}</summary>
          <p class="filter__note">{{ t.home.rules | fmt({ maxWind: windRules.maxWind, maxGust: windRules.maxGust, maxGustSpread: windRules.maxGustSpread, rainMaybe: windRules.rainMaybe | formatNumber(1), rainNo: windRules.rainNo | formatNumber(1) }) }}</p>
        </details>
      </div>
      {% endif %}
      {#- Mobile: direction, level and category behind the «Filter» button, which opens them as a panel from the bottom and
          shows how many are selected (home.js). On desktop everything is shown and the button is hidden. -#}
      <button type="button" class="filters-toggle" id="filters-toggle" aria-expanded="false" aria-controls="filters-more">{{ t.home.filters }}</button>
      <div class="filters-more" id="filters-more" role="group" aria-label="{{ t.home.filters }}">
      <div class="filter">
        <span class="filter__title" id="f-direction">{{ t.home.direction }}</span>
        <div class="compass" role="group" aria-labelledby="f-direction">
          {% for code in ["NW", "N", "NE", "W", null, "E", "SW", "S", "SE"] %}
          <button type="button" data-filter="direction" data-value="{{ code or '' }}" aria-pressed="{{ 'false' if code else 'true' }}"{% if not code %} class="compass__all"{% endif %}{% if code %} aria-label="{{ code | directionLabel }}, {{ code | directionWord }}"{% endif %}>{{ (code | directionLabel) if code else t.home.all }}</button>
          {% endfor %}
        </div>
      </div>
      <div class="filter">
        <span class="filter__title" id="f-level">{{ t.home.level }}</span>
        <div class="segmented" role="group" aria-labelledby="f-level">
          {% for value in ["", "PP2", "PP3", "PP4", "PP5"] %}
          <button type="button" data-filter="level" data-value="{{ value }}" aria-pressed="{{ 'true' if not value else 'false' }}">{{ value or t.home.all }}</button>
          {% endfor %}
        </div>
      </div>
      <div class="filter">
        <span class="filter__title" id="f-category">{{ t.home.category }}</span>
        <div class="segmented" role="group" aria-labelledby="f-category">
          {% for value in ["", "PG", "SPG", "PPG"] %}
          <button type="button" data-filter="category" data-value="{{ value }}" aria-pressed="{{ 'true' if not value else 'false' }}">{{ value or t.home.all }}</button>
          {% endfor %}
        </div>
      </div>
      <button type="button" class="filters-done" id="filters-done">{{ t.home.filtersDone }}</button>
      </div>
      <div class="filters-backdrop" id="filters-backdrop" hidden></div>
    </div>


    <section class="results" aria-labelledby="results-title">
      <h2 id="results-title">{{ t.home.sitesCount | fmt({ n: collections.sites.length }) }}</h2>
      <p class="muted" id="no-results" hidden>{{ t.home.noResults }}</p>
      <ul class="results__list" id="results-list">
        {% for s in collections.sites %}
        <li data-id="{{ s.data.id }}">
          <button type="button" class="results__item" data-select="{{ s.data.id }}">
            {#- Launch altitude to the right of the name, when recorded. -#}
            <span class="results__head"><span class="results__name">{{ s.data.name }}</span>{% if s.data.elevation and s.data.elevation.launch_masl %}<span class="results__elev">{{ s.data.elevation.launch_masl }} {{ t.units.masl }}</span>{% endif %}</span>
            <span class="directions">{% for code in (s.data.wind_directions.primary.concat(s.data.wind_directions.possible or [])) | sortDirections %}{{ m.directionBadge(code, s.data.wind_directions) }}{% endfor %}</span>
          </button>
        </li>
        {% endfor %}
      </ul>
      <p class="results__note muted">{{ t.home.resultsNote }}</p>
    </section>
    </div>

    <div class="home-pane" id="pane-weather" role="tabpanel" aria-labelledby="tab-weather" hidden>
      {#- Day plan («Når kan det passe?»): time windows per site for the next few days, from the forecast (home.js, dayWindows in wind.js). -#}
      {% if forecast %}
      <section class="day-plan" id="day-plan" aria-labelledby="day-plan-title" hidden>
        <h2 id="day-plan-title">{{ t.home.dayPlanTitle }}</h2>
        <p class="muted day-plan__note">{{ t.home.dayPlanNote }}</p>
        <div id="day-plan-days"></div>
      </section>
      {% endif %}
      <p class="muted">{{ t.home.weatherIntro }}</p>
      <nav class="link-list" aria-label="{{ t.home.weatherLabel }}">
        {{ m.linkRow("https://flybart.net/", "Flybart", t.home.flybart) }}
        {{ m.linkRow("http://xcc.no/xccflymet.html", "XCC flymet", t.home.xcc) }}
        {{ m.linkRow(t.home.yrUrl, "Yr", t.home.yrHarstad) }}
        {{ m.linkRow("https://www.windy.com/68.8/16.4?68.8,16.4,9", "Windy", t.home.windyHome) }}
      </nav>
    </div>

    <div class="home-pane" id="pane-info" role="tabpanel" aria-labelledby="tab-info" hidden>
      <section class="before-you-go" aria-labelledby="h-before-you-go">
        <h2 id="h-before-you-go">{{ t.home.beforeYouGo }}</h2>
        <nav class="link-list" aria-label="{{ t.home.beforeYouGo }}">
          {{ m.linkRow("https://ippc.no", t.home.notamTitle, "IPPC") }}
          {{ m.linkRow("/tarn/" | localeUrl, t.home.towersTitle, t.home.towersSubtitle, false) }}
        </nav>
      </section>
      <footer class="disclaimer">
        <p>{{ t.home.disclaimer }}</p>
        <p>{{ t.home.credit }}</p>
        <p>{{ t.home.openData | fmt({ geojson: '<a href="' ~ ('/flysteder.geojson' | url) ~ '" download>GeoJSON</a>', kml: '<a href="' ~ ('/flysteder.kml' | url) ~ '" download>KML</a>', license: '<a href="' ~ t.home.licenseUrl ~ '">CC BY 4.0</a>', docs: '<a href="https://github.com/hpgt-com/flying-sites/blob/main/docs/open-data.md">' ~ t.home.openDataDocs ~ '</a>' }) | safe }}</p>
        <p>{{ t.home.analytics | fmt({ goatcounter: '<a href="https://www.goatcounter.com/">GoatCounter</a>' }) | safe }}</p>
      </footer>
    </div>
  </div>

  <main class="home__map">
    {#- Map status (home.js): how many sites are shown, a wind summary for the selected time and when
        the forecast was fetched. Above the map on mobile, a semi-transparent card on top of the map on desktop. -#}
    <div class="map-info" id="map-info">
      <p class="map-info__count" id="map-count" aria-live="polite">{{ t.home.showingAll | fmt({ n: collections.sites.length }) }}</p>
      <div class="wind-summary" id="wind-summary" aria-live="polite" hidden></div>
      <p class="map-info__status" id="forecast-status" aria-live="polite"></p>
    </div>
    <div id="home-map" class="map map--home" data-home-region="{{ site.homeRegion }}" data-airspace-url="{{ '/assets/airspace.geojson' | url }}" role="region" aria-label="{{ t.home.mapLabel }}"></div>
    {#- Selected site: below the map on mobile, a card on top of the map at the bottom right on desktop (hidden until something is selected). -#}
    <section class="selected" id="selected" aria-live="polite">
      <p class="muted selected__empty">{{ t.home.selectHint }}</p>
    </section>
    {#- Legend: below the map on mobile, a small line at the bottom left of the map on desktop. -#}
    <div class="home__legend">
      {{ m.legend() }}
      {% if forecast %}
      <ul class="legend wind-legend" id="wind-legend" aria-label="{{ t.home.windLegendLabel }}">
        <li><span class="wind-dot wind-dot--ok"></span>{{ t.home.ratingOk }}</li>
        <li><span class="wind-dot wind-dot--maybe"></span>{{ t.home.ratingMaybe }}</li>
        <li><span class="wind-dot wind-dot--high"></span>{{ t.home.ratingHigh }}</li>
        <li><span class="wind-dot wind-dot--no"></span>{{ t.home.ratingNo }}</li>
        <li class="wind-legend__arrow">{{ t.home.windLegendArrow }}</li>
      </ul>
      {% endif %}
    </div>
  </main>

</div>

<script type="application/json" id="sites-data">{{ collections.sites | homeData(lang) | json | safe }}</script>
<script type="application/json" id="forecast-data">{{ { forecast: forecast, rules: windRules } | json | safe }}</script>

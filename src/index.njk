---
layout: base.njk
map: true
bodyClass: page-home
# One home page per language: / and /en/ (src/_data/languages.js).
pagination:
  data: languages
  size: 1
  alias: language
permalink: "{{ '/' | localeUrl(language.code) }}"
eleventyComputed:
  description: "{{ t.home.description }}"
scripts:
  - /assets/leaflet-markercluster/leaflet.markercluster.js
  - /assets/js/wind.js
  - /assets/js/home.js
---
{%- import "macros.njk" as m with context -%}
{%- set ICON_SITES = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M2 19 9 7l4 6 3-4 6 10z"/></svg>' -%}
{%- set ICON_WEATHER = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 8h11a3 3 0 1 0-3-3M3 12h16a3 3 0 1 1-3 3M3 16h8"/></svg>' -%}
{%- set ICON_FILTER = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>' -%}
<div class="home">
  <div class="home__left">
    <header class="topbar">
      <span class="logo"><img src="{{ '/assets/img/icon.svg' | url }}" width="28" height="28" alt="">{{ t.common.siteTitle }}</span>
      <div class="topbar__end">{{ m.siteMenu() }}</div>
    </header>

    <div class="home__intro">
      <p class="home__eyebrow">{{ t.home.eyebrow }}</p>
      <h1>{{ t.home.title }}</h1>
    </div>

    {#- Tabs (home.js): Flysteder (search, filters, list) and Vær. The map is always shown: on mobile it stays at the top of the
        screen while the list scrolls under it, on desktop it fills the right side. Info is in the menu. -#}
    <div class="home-tabs" role="tablist" aria-label="{{ t.home.tabsLabel }}">
      <button type="button" role="tab" id="tab-sites" aria-controls="pane-sites" aria-selected="true">{{ ICON_SITES | safe }}{{ t.home.tabSites }}</button>
      <button type="button" role="tab" id="tab-weather" aria-controls="pane-weather" aria-selected="false" tabindex="-1">{{ ICON_WEATHER | safe }}{{ t.home.tabWeather }}</button>
    </div>

    <div class="home-pane home-pane--sites" id="pane-sites" role="tabpanel" aria-labelledby="tab-sites">
      {#- Search and the «Filter» button in one row, which stays right below the map on mobile while the list scrolls.
          The search filters the list and the map while typing (home.js). -#}
      <div class="searchbar" id="filters" role="search">
        <label class="visually-hidden" for="site-search">{{ t.home.searchLabel }}</label>
        <input type="search" id="site-search" class="search-input" placeholder="{{ t.home.searchPlaceholder }}" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" aria-describedby="search-hits">
        <button type="button" class="filters-toggle" id="filters-toggle" aria-expanded="false" aria-controls="filters-more">{{ ICON_FILTER | safe }}{{ t.home.filters }}<span class="filters-toggle__count" hidden></span></button>
      </div>
      {#- Matches right below the field, so they are visible while typing. -#}
      <div class="search-hits" id="search-hits" aria-live="polite" hidden></div>
      {#- The chosen filters as chips under the search, each with ✕ to remove it, so they are visible with the panel closed (home.js). -#}
      <div class="filter-chips" id="filter-chips" role="group" aria-label="{{ t.home.chosenFilters }}" hidden></div>

      {#- Direction, level, category and «Bare steder som kan passe»: a panel from the bottom on mobile, folded out under the
          button on desktop (home.js). The button shows how many are chosen. -#}
      <div class="filters-more" id="filters-more" role="group" aria-labelledby="filters-title">
        {#- On mobile the panel is a dialog: the title and ✕ at the top, «Nullstill» and «Vis N flysteder» at the bottom, and Tab
            stays inside it while it is open (home.js). -#}
        <div class="filters-head">
          <h2 class="filters-head__title" id="filters-title">{{ t.home.filters }}</h2>
          <button type="button" class="filters-close" id="filters-close" aria-label="{{ t.home.filtersClose }}">{{ m.icon("close", 20) }}</button>
        </div>
        <div class="filter">
          <span class="filter__title" id="f-direction">{{ t.home.direction }}</span>
          {#- A small wind rose with eight sectors to tap, like the roses on the map. Several directions can be chosen, and
              the text beside it says which. Each sector is a button clipped to its wedge (clip-path). -#}
          <div class="dirpick">
            <div class="dirrose" role="group" aria-labelledby="f-direction">
              {% for code in ["N", "NE", "E", "SE", "S", "SW", "W", "NW"] %}
              <button type="button" class="dirrose__sector dirrose__sector--{{ code | lower }}" data-filter="direction" data-value="{{ code }}" aria-pressed="false" aria-label="{{ code | directionWord }}"><span>{{ code | directionLabel }}</span></button>
              {% endfor %}
              <button type="button" class="dirrose__all" data-filter="direction" data-value="" aria-pressed="true">{{ t.home.all }}</button>
            </div>
            <div class="dirpick__text">
              <strong id="direction-chosen">{{ t.home.allDirections }}</strong>
              <span>{{ t.home.directionHelp }}</span>
            </div>
          </div>
        </div>
        <div class="filter">
          <span class="filter__title" id="f-level">{{ t.home.level }}</span>
          <div class="pills" role="group" aria-labelledby="f-level">
            {% for value in ["", "PP2", "PP3", "PP4", "PP5"] %}
            <button type="button" class="pill" data-filter="level" data-value="{{ value }}" aria-pressed="{{ 'true' if not value else 'false' }}">{{ value or t.home.all }}</button>
            {% endfor %}
          </div>
        </div>
        <div class="filter">
          <span class="filter__title" id="f-category">{{ t.home.category }}</span>
          <div class="pills" role="group" aria-labelledby="f-category">
            {% for value in ["", "PG", "SPG", "PPG"] %}
            <button type="button" class="pill" data-filter="category" data-value="{{ value }}" aria-pressed="{{ 'true' if not value else 'false' }}">{{ value or t.home.all }}</button>
            {% endfor %}
          </div>
        </div>
        {% if forecast %}
        {#- Dims sites where the forecast says «Passer ikke» or «For mye vind» at the time chosen in the timeline (home.js). -#}
        <button type="button" class="suggest-switch" data-suggest aria-pressed="false">{{ t.home.suggest }}</button>
        {% endif %}
        <div class="filters-foot">
          <button type="button" class="filters-reset" id="filters-reset" hidden>{{ t.home.filtersReset }}</button>
          <button type="button" class="filters-done" id="filters-done">{{ t.home.filtersDone }}</button>
        </div>
      </div>
      <div class="filters-backdrop" id="filters-backdrop" hidden></div>

      <section class="results" aria-labelledby="results-title">
        <h2 id="results-title">{{ t.home.sitesCount | fmt({ n: collections.sites.length }) }}</h2>
        <p class="muted" id="no-results" hidden>{{ t.home.noResults }}</p>
        <ul class="results__list" id="results-list">
          {% for s in collections.sites %}
          <li data-id="{{ s.data.id }}">
            <button type="button" class="results__item" data-select="{{ s.data.id }}">
              {#- The rose is drawn by home.js, with the wind sector and rating ring. Without JavaScript the list is text only. -#}
              <span class="results__rose" aria-hidden="true"></span>
              <span class="results__body">
                {#- Launch altitude to the right of the name, when recorded. -#}
                <span class="results__head"><span class="results__name">{{ s.data.name }}</span>{% if s.data.elevation and s.data.elevation.launch_masl %}<span class="results__elev">{{ s.data.elevation.launch_masl }} {{ t.units.masl }}</span>{% endif %}</span>
                <span class="directions">{% for code in (s.data.wind_directions.primary.concat(s.data.wind_directions.possible or [])) | sortDirections %}{{ m.directionBadge(code, s.data.wind_directions) }}{% endfor %}</span>
              </span>
            </button>
            {#- Shown on the selected site on mobile. A second tap on the site opens it (home.js clicks this link). -#}
            <a class="results__open" href="{{ s.url | localeUrl(lang) | url }}" tabindex="-1">{{ t.home.tapAgain }}</a>
          </li>
          {% endfor %}
        </ul>
        <button type="button" class="results__more" id="results-more" hidden></button>
        <p class="results__note muted">{{ t.home.resultsNote }}</p>
      </section>
    </div>

    <div class="home-pane" id="pane-weather" role="tabpanel" aria-labelledby="tab-weather" hidden>
      {#- Day plan («Når kan det passe?»): time windows per site for the next few days, from the forecast (home.js, dayWindows in wind.js). -#}
      {% if forecast %}
      <section class="day-plan" id="day-plan" aria-labelledby="day-plan-title" hidden>
        <h2 id="day-plan-title">{{ t.home.dayPlanTitle }}</h2>
        <p class="muted day-plan__note">{{ t.home.dayPlanNote }}</p>
        <div id="day-plan-days"></div>
      </section>
      {% endif %}
      <p class="muted">{{ t.home.weatherIntro }}</p>
      <nav class="link-list" aria-label="{{ t.home.weatherLabel }}">
        {{ m.linkRow("https://flybart.net/", "Flybart", t.home.flybart) }}
        {{ m.linkRow("http://xcc.no/xccflymet.html", "XCC flymet", t.home.xcc) }}
        {{ m.linkRow(t.home.yrUrl, "Yr", t.home.yrHarstad) }}
        {{ m.linkRow("https://www.windy.com/68.8/16.4?68.8,16.4,9", "Windy", t.home.windyHome) }}
      </nav>
    </div>

    {#- Responsibility, sources, privacy and open data are on their own page. The short note that it is a rough guide is right
        below the list. The links for planning a trip (NOTAM, towers) are in the menu. -#}
    <footer class="disclaimer">
      <p><a href="{{ '/om/' | localeUrl }}">{{ t.common.aboutLink }}</a></p>
    </footer>
  </div>

  <main class="home__map" id="home-map-wrap">
    <div id="home-map" class="map map--home" data-home-region="{{ site.homeRegion }}" data-airspace-url="{{ '/assets/airspace.geojson' | url }}" role="region" aria-label="{{ t.home.mapLabel }}"></div>
    {#- Status on the map (home.js): a small pill with how many sites may work at the chosen time and the most common
        direction. It opens the details: the wind in the area, the count per rating, when the forecast was fetched,
        the legend and how the assessment works. -#}
    <div class="map-status">
      <button type="button" class="map-status__pill" id="map-status" aria-expanded="false" aria-controls="map-info">
        <span class="map-status__icon" aria-hidden="true"></span><span class="map-status__text" id="map-count" aria-live="polite">{{ t.home.showingAll | fmt({ n: collections.sites.length }) }}</span><span class="map-status__sub" id="map-status-sub"></span>
      </button>
      <div class="map-info" id="map-info" hidden>
        <div class="wind-summary" id="wind-summary" aria-live="polite" hidden></div>
        <p class="map-info__status" id="forecast-status" aria-live="polite"></p>
        {{ m.legend() }}
        {% if forecast %}
        <ul class="legend wind-legend" id="wind-legend" aria-label="{{ t.home.windLegendLabel }}">
          <li><span class="wind-dot wind-dot--ok"></span>{{ t.home.ratingOk }}</li>
          <li><span class="wind-dot wind-dot--maybe"></span>{{ t.home.ratingMaybe }}</li>
          <li><span class="wind-dot wind-dot--high"></span>{{ t.home.ratingHigh }}</li>
          <li><span class="wind-dot wind-dot--no"></span>{{ t.home.ratingNo }}</li>
          <li class="wind-legend__arrow">{{ t.home.windLegendArrow }}</li>
        </ul>
        <details class="wind-rules">
          <summary>{{ t.home.rulesSummary }}</summary>
          <p class="filter__note">{{ t.home.rules | fmt({ maxWind: windRules.maxWind, maxGust: windRules.maxGust, maxGustSpread: windRules.maxGustSpread, rainMaybe: windRules.rainMaybe | formatNumber(1), rainNo: windRules.rainNo | formatNumber(1) }) }}</p>
        </details>
        {% endif %}
      </div>
    </div>
    {% if forecast %}
    {#- The time for the wind assessment: «Nå» and a slider over the hours in the forecast. The track is coloured by the best
        rating among the sites matching the filters, hour by hour, so you can see when it may work (home.js). -#}
    <div class="timeline" id="timeline" hidden>
      <button type="button" class="timeline__now" id="timeline-now" aria-pressed="true">{{ t.home.now }}</button>
      <label class="timeline__time" for="timeline-range" id="timeline-time"></label>
      <div class="timeline__track">
        <div class="timeline__bar" id="timeline-bar" aria-hidden="true"></div>
        <input type="range" id="timeline-range" min="0" max="47" step="1" value="0">
        <div class="timeline__days" id="timeline-days" aria-hidden="true"></div>
      </div>
    </div>
    {% endif %}
    {#- Mobile: a short line on the map about the selected site, with a link to the site page. Desktop: the card. -#}
    <div class="map-note" id="map-note" hidden></div>
    <section class="selected" id="selected" aria-live="polite">
      <p class="muted selected__empty">{{ t.home.selectHint }}</p>
    </section>
  </main>

</div>

<script type="application/json" id="sites-data">{{ collections.sites | homeData(lang) | json | safe }}</script>
<script type="application/json" id="forecast-data">{{ { forecast: forecast, rules: windRules } | json | safe }}</script>

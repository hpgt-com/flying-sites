{#- Wind rose with eight sectors. Order: N, NE, E, SE, S, SW, W, NW. Same paths in assets/js/common.js. -#}
{% macro rose(windDirections, size=120, labels=true) -%}
{%- set ROSE_PATHS = [
  "M58.8 21.7 A62 62 0 0 1 101.2 21.7 L85.5 65.0 A16 16 0 0 0 74.5 65.0Z",
  "M106.2 23.8 A62 62 0 0 1 136.2 53.8 L94.5 73.2 A16 16 0 0 0 86.8 65.5Z",
  "M138.3 58.8 A62 62 0 0 1 138.3 101.2 L95.0 85.5 A16 16 0 0 0 95.0 74.5Z",
  "M136.2 106.2 A62 62 0 0 1 106.2 136.2 L86.8 94.5 A16 16 0 0 0 94.5 86.8Z",
  "M101.2 138.3 A62 62 0 0 1 58.8 138.3 L74.5 95.0 A16 16 0 0 0 85.5 95.0Z",
  "M53.8 136.2 A62 62 0 0 1 23.8 106.2 L65.5 86.8 A16 16 0 0 0 73.2 94.5Z",
  "M21.7 101.2 A62 62 0 0 1 21.7 58.8 L65.0 74.5 A16 16 0 0 0 65.0 85.5Z",
  "M23.8 53.8 A62 62 0 0 1 53.8 23.8 L73.2 65.5 A16 16 0 0 0 65.5 73.2Z"
] -%}
{%- set primary = windDirections.primary or [] -%}
{%- set possible = windDirections.possible or [] -%}
<svg class="rose" width="{{ size }}" height="{{ size }}" viewBox="{{ '-12 -12 184 184' if labels else '18 18 124 124' }}" role="img"
  aria-label="{{ t.common.roseLabel | fmt({ primary: (primary | directionLabels) or t.common.noneLabel }) }}{% if possible.length %}{{ t.common.rosePossible | fmt({ possible: possible | directionLabels }) }}{% endif %}">
  {%- for code in DIRECTIONS %}
  <path d="{{ ROSE_PATHS[loop.index0] }}" class="sector sector--{{ code | directionType(windDirections) }}"></path>
  {%- endfor %}
  <circle cx="80" cy="80" r="9" class="rose__center"></circle>
  {%- if labels %}
  <text x="80" y="2" text-anchor="middle">{{ "N" | directionLabel }}</text>
  <text x="80" y="168" text-anchor="middle">{{ "S" | directionLabel }}</text>
  <text x="-4" y="85" text-anchor="middle">{{ "W" | directionLabel }}</text>
  <text x="164" y="85" text-anchor="middle">{{ "E" | directionLabel }}</text>
  {%- endif %}
</svg>
{%- endmacro %}

{% macro directionBadge(code, windDirections) -%}
<span class="direction direction--{{ code | directionType(windDirections) }}" title="{{ code | directionWord }}">{{ code | directionLabel }}</span>
{%- endmacro %}

{% macro tag(text, variant="") -%}
<span class="tag{% if variant %} tag--{{ variant }}{% endif %}">{{ text }}</span>
{%- endmacro %}

{% macro legend(windDirections=null) -%}
<ul class="legend" aria-label="{{ t.common.legendLabel }}">
  <li><span class="swatch swatch--primary"></span>{{ t.common.legendPrimary }}{% if windDirections and windDirections.primary.length %} {{ windDirections.primary | directionLabels }}{% endif %}</li>
  <li><span class="swatch swatch--possible"></span>{{ t.common.legendPossible }}{% if windDirections and windDirections.possible.length %} {{ windDirections.possible | directionLabels }}{% endif %}</li>
  <li><span class="swatch swatch--none"></span>{{ t.common.legendNone }}</li>
</ul>
{%- endmacro %}

{#- Small line icons in front of button and menu texts, so they are quick to recognise. Same style as the menu links. -#}
{% macro icon(name, size=18) -%}
{%- set ICONS = {
  directions: '<path d="M12 3l7 18-7-4-7 4z"/>',
  map: '<path d="M9 4L3 6v14l6-2 6 2 6-2V4l-6 2z"/><path d="M9 4v14M15 6v14"/>',
  download: '<path d="M12 4v11M7 10l5 5 5-5M5 20h14"/>',
  cloud: '<path d="M7 19h10a4 4 0 0 0 .5-8A6 6 0 0 0 6 10.5 4.3 4.3 0 0 0 7 19z"/>',
  wind: '<path d="M3 8h11a3 3 0 1 0-3-3M3 12h16a3 3 0 1 1-3 3M3 16h8"/>',
  log: '<path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z"/><path d="M5 17a3 3 0 0 1 3-3h11M9 8h6"/>',
  link: '<path d="M10 14a4 4 0 0 0 5.7 0l3-3A4 4 0 0 0 13 5.3l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>',
  auto: '<circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  moon: '<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  eye: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>'
} -%}
<svg class="icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ ICONS[name] | safe }}</svg>
{%- endmacro %}

{% macro chevron(direction="right") -%}
<svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {%- if direction == "left" %}<path d="M15 18l-6-6 6-6"></path>{% else %}<path d="M9 18l6-6-6-6"></path>{% endif -%}
</svg>
{%- endmacro %}

{#- Menu at the top right: language, colour mode, colour-blind-friendly colours and links. common.js stores the choices
    and updates the page. The button is hidden without JavaScript. The language switch links to the same page in the
    other language when the page exists in several languages (language is set), otherwise to that language's home page. -#}
{% macro siteMenu() -%}
<div class="site-menu">
  <button type="button" class="site-menu__button" aria-expanded="false" aria-controls="site-menu-panel" hidden>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    <span class="visually-hidden">{{ t.common.menu }}</span>
  </button>
  <div class="site-menu__panel" id="site-menu-panel" hidden>
    {#- First what is used most: planning a trip (the weather stations, NOTAM, towers); then the club and the site («Meld
        fra», about and privacy, hpgt.com); the settings last. Each link has an icon, so the list is quick to read.
        «Alle flysteder» is not here: it is at the top left of every page, and the home page is the list. -#}
    <p class="site-menu__label" id="plan-label">{{ t.common.menuPlan }}</p>
    <nav class="site-menu__links" aria-labelledby="plan-label">
      <a href="{{ '/vaer/' | localeUrl }}"><svg class="site-menu__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h11a3 3 0 1 0-3-3"/><path d="M3 12h15a3 3 0 1 1-3 3"/><path d="M3 16h7"/></svg>{{ t.weather.menuLink }} <span class="site-menu__sub">{{ t.weather.menuSub }}</span></a>
      <a href="https://ippc.no" target="_blank" rel="noopener"><svg class="site-menu__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>{{ t.home.notamTitle }} <span class="site-menu__sub">IPPC</span>{{ external() }}</a>
      <a href="{{ '/tarn/' | localeUrl }}"><svg class="site-menu__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>{{ t.home.towersTitle }} <span class="site-menu__sub">{{ t.home.towersSubtitle }}</span></a>
    </nav>
    <p class="site-menu__label" id="club-label">{{ t.common.menuClub }}</p>
    <nav class="site-menu__links" aria-labelledby="club-label">
      <a href="{{ '/meld-fra/' | localeUrl }}"><svg class="site-menu__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M12 7v4M12 14v.5"/></svg>{{ t.report.menuLink }} <span class="site-menu__sub">{{ t.report.menuSub }}</span></a>
      <a href="{{ '/om/' | localeUrl }}"><svg class="site-menu__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg>{{ t.common.aboutLink }}</a>
      <a href="{{ site.hpgtUrl }}"><svg class="site-menu__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/></svg>{{ t.common.toHpgt }}</a>
    </nav>
    <p class="site-menu__label site-menu__label--settings">{{ t.common.menuSettings }}</p>
    <p class="site-menu__label" id="language-label">{{ icon("globe", 14) }}{{ t.common.language }}</p>
    <div class="theme-toggle language-toggle" role="group" aria-labelledby="language-label">
      {%- for l in languages %}
      <a href="{{ (page.url | localeUrl(l.code)) if language else (l.prefix ~ '/') }}" hreflang="{{ l.code }}" lang="{{ l.code }}" data-language="{{ l.code }}"{% if l.code == lang %} aria-current="true"{% endif %}>{{ l.name }}</a>
      {%- endfor %}
    </div>
    <p class="site-menu__label" id="theme-label">{{ icon("auto", 14) }}{{ t.common.theme }}</p>
    <div class="theme-toggle" role="group" aria-labelledby="theme-label">
      <button type="button" data-theme-choice="auto" aria-pressed="false" title="{{ t.common.themeAutoTitle }}">{{ icon("auto", 16) }}{{ t.common.themeAuto }}</button>
      <button type="button" data-theme-choice="light" aria-pressed="false">{{ icon("sun", 16) }}{{ t.common.themeLight }}</button>
      <button type="button" data-theme-choice="dark" aria-pressed="false">{{ icon("moon", 16) }}{{ t.common.themeDark }}</button>
    </div>
    <button type="button" class="switch" role="switch" aria-checked="false" data-cvd-toggle>
      <span class="switch__text">{{ icon("eye", 16) }}{{ t.common.cvd }}<span class="switch__hint">{{ t.common.cvdHint }}</span></span>
      <span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
    </button>
  </div>
</div>
{%- endmacro %}

{#- The form of «Meld fra» (report.js), on each site page and on /meld-fra/. kinds: the choices for what it concerns
    (workers/data/src/report.js has the same lists). -#}
{% macro reportForm(kinds, messageLabel) -%}
<form class="report__form" id="report-form" novalidate>
  <label class="report__field">{{ t.report.kind }}
    <select name="kind" required>
      {% for k in kinds %}<option value="{{ k }}">{{ t.report["kind_" + k] }}</option>{% endfor %}
    </select>
  </label>
  <label class="report__field">{{ messageLabel or t.report.message }}
    <textarea name="message" rows="4" minlength="10" maxlength="1000" required aria-describedby="report-message-hint"></textarea>
    <span class="muted report__hint" id="report-message-hint">{{ t.report.messageHint }}</span>
  </label>
  <label class="report__field">{{ t.report.name }}
    <input type="text" name="name" maxlength="80" autocomplete="name">
  </label>
  <div class="report__check" id="report-check"></div>
  <button type="submit" class="btn report__send">{{ t.report.send }}</button>
  <p class="report__status" id="report-status" role="status" aria-live="polite"></p>
  <p class="muted report__privacy">{{ t.report.privacy }}</p>
</form>
{%- endmacro %}

{#- Image that opens in the lightbox (lightbox.js). Without JavaScript the link opens the large image.
    With thumb=false a hidden link without an image is made, which only exists in the lightbox («Se alle N bilder»). -#}
{% macro lightboxLink(image, caption, thumb=true) -%}
<a href="{{ image.fullUrl }}" class="lightbox-link" data-lightbox data-lightbox-index="{{ image.index }}" data-alt="{{ image.alt }}"{% if not thumb %} hidden tabindex="-1"{% endif %} data-caption="{{ caption }}" data-srcset-webp="{{ image.srcsetWebp }}" data-srcset-jpeg="{{ image.srcsetJpeg }}" data-width="{{ image.width }}" data-height="{{ image.height }}"{% if image.credit %} data-credit="{{ image.credit.creator }}" data-credit-url="{{ image.credit.url or '' }}" data-license="{{ image.credit.license }}" data-license-url="{{ image.credit.licenseUrl }}"{% endif %}>{% if thumb %}{{ image.html | safe }}<span class="visually-hidden"> {{ t.common.showLarger }}</span>{% endif %}</a>
{%- endmacro %}

{#- Marker for links that open in a new tab: a ↗ symbol, and text read only by screen readers. -#}
{% macro external() -%}
<svg class="external-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"></path><path d="M8 7h9v9"></path></svg><span class="visually-hidden"> {{ t.common.opensNewTab }}</span>
{%- endmacro %}

{#- External lookups (weather, airspace etc.) open in a new tab, so the site page stays open. Internal links (external=false) do not. -#}
{% macro linkRow(href, title, subtitle, isExternal=true) -%}
<a class="link-row" href="{{ href }}"{% if isExternal %} target="_blank" rel="noopener"{% endif %}><span><span class="link-row__title">{{ title }}</span><span class="link-row__subtitle">{{ subtitle }}</span></span>{% if isExternal %}{{ external() }}{% else %}{{ chevron() }}{% endif %}</a>
{%- endmacro %}

---
layout: base.njk
noAddressDetection: true
bodyClass: page-site
scripts:
  - /assets/leaflet-markercluster/leaflet.markercluster.js
  - /assets/js/wind.js
  - /assets/js/site.js
  - /assets/js/site-wind.js
  - /assets/js/lightbox.js
---
{%- import "macros.njk" as m with context -%}
{%- set routes = derived.routes -%}
{%- set notReviewed = not (reviewed and reviewed.by and reviewed.date) -%}
{%- set intro = content | section("intro") -%}
<div class="site-page">
  <header class="topbar">
    <a class="back-link" href="/">{{ m.chevron("left") }}Alle flysteder</a>
    <span class="topbar__end">{% if region %}<span class="topbar__region">{{ region }}</span>{% endif %}{{ m.siteMenu() }}</span>
  </header>

  <div class="site-page__grid">
    {# 1. Navn og kort fortalt. Kategori og sesong står i Fakta. «Ikke gjennomgått» står her, fordi det er en advarsel. #}
    <section class="block block--title" aria-labelledby="site-name">
      <h1 id="site-name">{{ name }}{% if elevation and elevation.launch_masl %} <span class="title-elev">{{ elevation.launch_masl }} moh</span>{% endif %}</h1>
      {% if intro %}<div class="lead">{{ intro | safe }}</div>{% endif %}
      {% if notReviewed %}<div class="tags">{{ m.tag("Ikke gjennomgått ennå", "warning") }}</div>{% endif %}
    </section>

    {#- Før du starter: øverst til høyre på PC (ved siden av tittelen), rett etter tittelen på mobil.
        Rolig ravfarge: dette er viktig informasjon til piloten, ikke en alarm. -#}
    <section class="block block--notice{% if not hazards.length %} block--notice-empty{% endif %}" aria-labelledby="h-hazards">
      <h2 id="h-hazards"><span class="notice-icon" aria-hidden="true">!</span>Før du starter</h2>
      {% for hazard in hazards %}
      <div class="hazard">
        <strong>{{ hazard.title }}</strong>
        <span>{{ hazard.text }}</span>
      </div>
      {% else %}
      {#- Uten gjennomgang betyr tom liste bare at ingen har lagt inn farer, ikke at det ikke finnes noen. -#}
      {% if notReviewed %}
      <p><strong>Farene er ikke gjennomgått ennå.</strong> At ingen er registrert, betyr ikke at stedet er uten farer. Spør klubben eller lokale piloter før du flyr her.</p>
      {% else %}
      <p>Ingen spesielle farer registrert for stedet.</p>
      {% endif %}
      {% endfor %}
    </section>

    <div class="site-page__main">

      {# 2. Kart: start, retningsbuer, punkter, landing, parkering og gangrute #}
      <section class="block block--map" aria-labelledby="h-map">
        <h2 id="h-map">Kart</h2>
        <div id="site-map" class="map map--site" role="region" aria-label="Kart over {{ name }} med start, landing, parkering og gangrute"></div>
        <ul class="map-legend" aria-label="Tegnforklaring for kartet">
          <li><span class="map-symbol map-symbol--launch-dot"></span>Start</li>
          {% if landings.length %}<li><span class="map-symbol map-symbol--landing"></span>Landing</li>{% endif %}
          {#- Andre landinger med eget navn (for eksempel «SPG-landing») står med navnet, ellers «Alternativ landing». -#}
          {% for l in landings | rejectattr("primary") %}{% if l.name and l.name != "Landing" %}<li><span class="map-symbol map-symbol--landing map-symbol--alt"></span>{{ l.name }}</li>{% elif loop.first %}<li><span class="map-symbol map-symbol--landing map-symbol--alt"></span>Alternativ landing</li>{% endif %}{% endfor %}
          {% if parking.length %}<li><span class="symbol symbol--parking">P</span>Parkering</li>{% endif %}
          {% if routes.length %}<li><span class="symbol symbol--route"></span>Gangrute</li>{% endif %}
          {% if wind_directions.primary.length %}<li><span class="symbol drawing-swatch drawing-swatch--arrow"></span>Retningene stedet passer for</li>{% endif %}
          {% if wind_directions.possible.length %}<li><span class="symbol drawing-swatch drawing-swatch--possible"></span>Mulig retning</li>{% endif %}
          {%- set hasPins = false %}{% set hasHazard = false %}
          {%- if derived.drawing %}{% for f in derived.drawing.features %}{% if f.properties.kind == "label" %}{% set hasPins = true %}{% if f.properties.style == "hazard" %}{% set hasHazard = true %}{% endif %}{% endif %}{% endfor %}{% endif %}
          {% if hasPins %}<li><span class="drawing-pin drawing-pin--legend">1</span>Punkt, trykk for å lese</li>{% endif %}
          {% if hasHazard %}<li><span class="drawing-pin drawing-pin--hazard drawing-pin--legend">!</span>Fare</li>{% endif %}
        </ul>
        <div class="buttons">
          {% for p in parking %}
          <a class="btn btn--primary" href="https://www.google.com/maps/dir/?api=1&destination={{ p.lat }},{{ p.lon }}" target="_blank" rel="noopener">Veibeskrivelse til {{ "parkering" if parking.length == 1 else p.name }}{{ m.external() }}</a>
          {% endfor %}
          {% for r in routes %}
          <a class="btn" href="{{ r.url }}" download>Last ned gangrute{% if routes.length > 1 %} {{ r.name or loop.index }}{% endif %} (GPX)</a>
          {% endfor %}
        </div>
        {% if not parking.length %}<p class="missing">Parkering er ikke registrert ennå.</p>{% endif %}


        {#- Punkter fra tegningen (<id>-drawing.geojson), med samme nummer som i kartet (site.js). -#}
        {%- set points = [] -%}
        {%- if derived.drawing %}{% for f in derived.drawing.features %}{% if f.properties.kind == "label" and f.properties.title %}{% set points = (points.push(f), points) %}{% endif %}{% endfor %}{% endif %}
        {% if points.length %}
        <div class="points">
          <h3>Punkter i kartet</h3>
          <ol class="drawing-list">
            {% for f in points %}
            <li data-n="{{ loop.index }}">
              <button type="button" data-n="{{ loop.index }}" aria-label="Vis punkt {{ loop.index }} i kartet"><span class="drawing-pin{% if f.properties.style == 'hazard' %} drawing-pin--hazard{% endif %}">{{ loop.index }}</span></button>
              <div><strong>{{ f.properties.title }}</strong>{% if f.properties.text %}<span>{{ f.properties.text }}</span>{% endif %}</div>
            </li>
            {% endfor %}
          </ol>
        </div>
        {% endif %}

      </section>

      {# 3. Adkomst: parkering, veien opp og høydeprofil, rett etter kartet der gangruten vises #}
      <section class="block block--access" aria-labelledby="h-access">
        <h2 id="h-access">Adkomst</h2>
        {#- Adkomst som tall når stedet har én gangrute: lengde, høydemeter og tid til fots. -#}
        {% set oneRoute = routes[0] if routes.length == 1 else null %}
        {% if oneRoute %}
        <div class="access-stats" aria-label="Gangruten">
          <div><strong>{{ oneRoute.lengthKm | formatNumber(1) }}</strong> <span>km</span><small>Gangrute</small></div>
          {% if oneRoute.elevationGain %}<div><strong>{{ (oneRoute.elevationGain / 10) | round * 10 }}</strong> <span>m</span><small>Stigning</small></div>{% endif %}
          {% if oneRoute.walkTimeMin %}<div><strong>{{ oneRoute.walkTimeMin }}</strong> <span>min</span><small>Til fots</small></div>{% endif %}
        </div>
        {% endif %}
        <dl class="row-list">
          <div>
            <dt>Parkering</dt>
            <dd>{{ access.parking_text or "" }}{% if not access.parking_text %}<span class="missing">Ikke registrert ennå</span>{% endif %}</dd>
          </div>
          <div>
            <dt>Veien opp</dt>
            <dd>
              {% if access.route_text %}{{ access.route_text }}{% elif oneRoute %}Følg gangruten i kartet.{% elif not routes.length %}<span class="missing">Ikke registrert ennå</span>{% endif %}
              {% for r in routes if not oneRoute %}
              <span class="route-stats">{% if routes.length > 1 %}{{ (r.name or ("rute " ~ loop.index)) | capitalizeFirst }}: {% else %}Gangrute: {% endif %}{{ r.lengthKm | formatNumber(1) }} km{% if r.elevationGain %} og ca. {{ (r.elevationGain / 10) | round * 10 }} høydemeter{% endif %}.</span>
              {% endfor %}
            </dd>
          </div>
          {% if not (oneRoute and oneRoute.walkTimeMin) %}
          <div>
            <dt>Tid</dt>
            <dd>
              {% set hasTime = (routes | selectattr("walkTimeMin") | list | length) or (not routes.length and access.walk_time_min) %}
              {% for r in routes %}{% if r.walkTimeMin %}
              <span class="route-stats">{% if routes.length > 1 %}{{ (r.name or ("rute " ~ loop.index)) | capitalizeFirst }}: {% endif %}Ca. {{ r.walkTimeMin }} min til fots</span>
              {% endif %}{% endfor %}
              {% if not routes.length and access.walk_time_min %}Ca. {{ access.walk_time_min }} min til fots{% endif %}
              {% if not hasTime %}<span class="missing">Ikke registrert ennå</span>{% endif %}
            </dd>
          </div>
          {% endif %}
        </dl>
        {#- Høydeprofilen hører til gangruten. Glidebryteren viser posisjonen i kartet like over. -#}
        {% if routes | selectattr("profile") | list | length %}
        <div class="profile" id="elevation-profile">
          <h3>Høydeprofil</h3>
          {% if routes.length > 1 %}
          <div class="pills" role="tablist" aria-label="Velg gangrute">
            {% for r in routes %}
            <button type="button" class="pill" role="tab" data-route="{{ loop.index0 }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ (r.name or ("rute " ~ loop.index)) | capitalizeFirst }}</button>
            {% endfor %}
          </div>
          {% endif %}
          <svg class="profile__graph" viewBox="0 0 350 150" preserveAspectRatio="none" role="img" aria-label="Høydeprofil for gangruten"></svg>
          <input class="profile__slider" type="range" min="0" max="1" value="0" aria-label="Posisjon langs ruten">
          <div class="profile__values" aria-live="polite">
            <span><span class="muted">Avstand </span><strong data-readout="distance">0 km</strong></span>
            <span><span class="muted">Høyde </span><strong data-readout="elevation"></strong></span>
            <span><span class="muted">Stigning </span><strong data-readout="grade"></strong></span>
          </div>
          <div class="profile__legend"><span class="stroke-swatch"></span>Brattere enn 25 %</div>
          <p class="profile__summary"></p>
        </div>
        {% endif %}
      </section>

      {# 4. Start #}
      <section class="block block--launch" aria-labelledby="h-launch">
        <h2 id="h-launch">Start</h2>
        {% set launchText = content | section("Start") %}
        {% if launchText %}<div class="prose">{{ launchText | safe }}</div>{% endif %}
        {% if launches.length %}
        {#- Kategori (PG/SPG) i egen kolonne mellom retningene og teksten, bare når noen start har kategori. -#}
        {%- set hasLaunchCategories = false -%}
        {%- for group in derived.launchGroups %}{% if group.categories.length %}{% set hasLaunchCategories = true %}{% endif %}{% endfor %}
        <ul class="launch-list{% if hasLaunchCategories %} launch-list--categories{% endif %}" aria-label="Starter per vindretning">
          {#- Starter med samme retninger er slått sammen til én linje (groupLaunches i flysteder.11tydata.js). -#}
          {% for group in derived.launchGroups %}
          <li>
            <span class="launch-list__badges">
              {% for code in group.directions %}{{ m.directionBadge(code, wind_directions) }}{% endfor %}
            </span>
            {% if hasLaunchCategories %}<span class="launch-list__categories">{% for c in group.categories %}{{ m.tag(c) }}{% endfor %}</span>{% endif %}
            <span class="launch-list__texts">{% for t in group.texts %}<span>{{ t }}</span>{% endfor %}</span>
          </li>
          {% endfor %}
        </ul>
        {% endif %}
      </section>

      {# 5. Landing #}
      <section class="block block--landing" aria-labelledby="h-landing">
        <h2 id="h-landing">Landing</h2>
        {% set landingText = content | section("Landing") %}
        {% if landingText %}<div class="prose">{{ landingText | safe }}</div>{% else %}<p class="missing">Ingen beskrivelse av landingen ennå.</p>{% endif %}
      </section>

    </div>

    <div class="site-page__aside">
      {# 6. Fakta #}
      <section class="block block--facts" aria-labelledby="h-facts">
        <h2 id="h-facts">Fakta</h2>
        <div class="rose-facts">
          {{ m.rose(wind_directions, 120) }}
          {{ m.legend(wind_directions) }}
        </div>
        <dl class="facts">
          <div class="facts__trio">
            <div>
              <dt>Nivå</dt>
              <dd class="tags">
                {% if level %}{{ m.tag(level) }}{% else %}{{ m.tag("Ikke satt", "missing") }}{% endif %}
                {% if training_site %}{{ m.tag("Kursplass") }}{% endif %}
              </dd>
            </div>
            <div>
              <dt>Kategori</dt>
              <dd class="tags">{% for c in categories %}{{ m.tag(c) }}{% else %}{{ m.tag("Ikke satt", "missing") }}{% endfor %}</dd>
            </div>
            {% if season %}
            <div>
              <dt>Sesong</dt>
              <dd class="tags">{{ m.tag(season) }}</dd>
            </div>
            {% endif %}
          </div>
          {% if wind_limits and wind_limits.max_wind %}
          <div>
            <dt>Maks vind</dt>
            <dd>{{ wind_limits.max_wind }} m/s <span class="muted">(brukes i vindvurderingen på forsiden)</span></dd>
          </div>
          {% endif %}
          <div>
            <dt>Høyde</dt>
            <dd class="elevations">
              {% for label, value, unit in [["Start", elevation.launch_masl, "moh"], ["Landing", elevation.landing_masl, "moh"], ["Forskjell", elevation.difference_m, "m"]] %}
              <span><span class="muted">{{ label }}</span>{% if value or value === 0 %}<strong>{{ value }} {{ unit }}</strong>{% else %}<span class="missing">Ikke registrert</span>{% endif %}</span>
              {% endfor %}
            </dd>
          </div>
          <div>
            <dt>Luftrom over start</dt>
            <dd class="airspace">
              {% if derived.airspace %}
              {#- Hentet automatisk fra openAIP (npm run airspace). Viser bare taket over start: det laveste faste
                  luftrommet over startstedet. Navn fra stedsfilens airspace overstyrer når type og nedre grense er like. -#}
              {% set ceiling = derived.airspaceCeiling %}
              {% if ceiling %}
              {% set a = ceiling.airspace %}
              <span class="tags">
                {{ m.tag(a.name) }}
                {% if a["class"] %}{{ m.tag("Klasse " ~ a["class"]) }}{% endif %}
                {{ m.tag("Fra bakken" if ceiling.fromGround else "Nedre " ~ (a.lower | formatLimit)) }}
                {% if a.lower | limitMasl %}{{ m.tag(a.lower | limitMasl) }}{% endif %}
                {% if ceiling.aboveLaunch != null and ceiling.aboveLaunch < 0 %}{{ m.tag("Starten er over grensen", "warning") }}{% endif %}
              </span>
              {% if a.note %}<span class="muted">{{ a.note }}</span>{% endif %}
              {% else %}
              <span class="muted">Ingen faste luftrom over starten.</span>
              {% endif %}
              <span class="airspace__source">Hentet automatisk fra openAIP {{ derived.airspace.fetched | formatDate }}.<br>Sjekk alltid <a href="https://ippc.no" target="_blank" rel="noopener">IPPC{{ m.external() }}</a> før du flyr. <a href="/luftrom/">Telefonnumre til tårnene</a></span>
              {% else %}
              {% set mainAirspace = airspace | rejectattr("nearby") | list %}
              {% for a in mainAirspace %}
              <span class="tags">
                {{ m.tag(a.name) }}
                {% if a["class"] %}{{ m.tag("Klasse " ~ a["class"]) }}{% endif %}
                {% if a.lower and a.lower.unit == "FT" %}{{ m.tag("Nedre " ~ a.lower.value ~ " ft") }}{% if a.lower.ref == "MSL" %}{{ m.tag("ca. " ~ (a.lower.value | feetToMeters) ~ " moh") }}{% endif %}
                {% elif a.lower and a.lower.unit == "FL" %}{{ m.tag("Nedre FL " ~ a.lower.value) }}{% endif %}
              </span>
              {% if a.note %}<span class="muted">{{ a.note }}</span>{% endif %}
              {% endfor %}
              {% if not mainAirspace.length %}<span class="missing">Ikke registrert ennå. Sjekk <a href="https://ippc.no" target="_blank" rel="noopener">IPPC{{ m.external() }}</a>.</span>{% endif %}
              {% endif %}
            </dd>
          </div>
        </dl>
      </section>

      {# 7. Vær #}
      <section class="block block--weather" aria-labelledby="h-weather">
        <h2 id="h-weather">Vær</h2>
        {#- Vinden nå for starten, fra MET-varselet som forsiden bruker (site-wind.js). Skjult uten varsel. -#}
        <div class="site-wind" id="site-wind" aria-live="polite" hidden></div>
        {% if external.yr_id %}
        <figure class="meteogram">
          <a href="https://www.yr.no/nb/v%C3%A6rvarsel/daglig-tabell/{{ external.yr_id }}" target="_blank" rel="noopener"><span class="visually-hidden">Værvarsel på Yr (åpnes i ny fane)</span><img src="https://www.yr.no/nb/innhold/{{ external.yr_id }}/meteogram.svg" data-src-dark="https://www.yr.no/nb/innhold/{{ external.yr_id }}/meteogram.svg?mode=dark" alt="Meteogram fra Yr for {{ name }}" loading="lazy"></a>
          <figcaption>Varsel fra Yr, levert av NRK og Meteorologisk institutt. Trykk for time for time.</figcaption>
        </figure>
        {% else %}
        <div class="placeholder placeholder--short">Yr-sted er ikke lagt inn for {{ name }} ennå.</div>
        {% endif %}
        <nav class="link-list" aria-label="Værtjenester">
          {{ m.linkRow("https://www.windy.com/" ~ launch.lat ~ "/" ~ launch.lon ~ "?" ~ launch.lat ~ "," ~ launch.lon ~ ",12", "Windy", "Vind i høyden og modeller") }}
          {{ m.linkRow("https://flybart.net/", "Flybart", "Værstasjoner i området") }}
          {{ m.linkRow("http://xcc.no/xccflymet.html", "XCC flymet", "Værstasjonene til Egil Fonn") }}
        </nav>
      </section>

      {#- 8. Bilder: første oversiktsbilde (fra luften, fra landingen mot starten eller utsikt fra starten) stort øverst
          (samme som forhåndsbildet når siden deles), første start og første landing under. Har stedet flere bilder,
          åpner «Se alle N bilder» bildevisningen med alle, i rekkefølgen oversikt, start, landing.
          Mangler noen typer, vises bare de som finnes, og én linje om å sende inn bilder. -#}
      {%- set shown = derived.images | selectattr("featured") | list -%}
      {%- set extra = derived.images | rejectattr("featured") | list -%}
      <section class="block block--images" aria-labelledby="h-images">
        <h2 id="h-images">Bilder</h2>
        {% if shown.length %}
        <div class="image-grid">
          {% for image in shown %}
          <figure>
            {{ m.lightboxLink(image, image.caption) }}
            <figcaption>{{ image.caption }}</figcaption>
          </figure>
          {% endfor %}
        </div>
        {% endif %}
        {% if extra.length %}
        {#- Knappen vises av lightbox.js. Uten JavaScript finnes bare bildene over. -#}
        <button type="button" class="big-btn images-all" data-lightbox-all hidden><span>Se alle {{ derived.images.length }} bilder</span></button>
        {% for image in extra %}{{ m.lightboxLink(image, image.caption, false) }}{% endfor %}
        {% endif %}
        {#- Fotografene og lisensen, én gang per fotograf. Står også i bildenes metadata og i bildevisningen. -#}
        {%- set creators = [] -%}{%- set creatorNames = [] -%}
        {%- for image in derived.images %}{% if image.credit and not (image.credit.creator in creatorNames) %}{% set creatorNames = (creatorNames.push(image.credit.creator), creatorNames) %}{% set creators = (creators.push(image.credit), creators) %}{% endif %}{% endfor %}
        {% if creators.length %}
        <p class="images-credit">Foto: {% for c in creators %}{% if c.url %}<a href="{{ c.url }}" target="_blank" rel="noopener">{{ c.creator }}</a>{% else %}{{ c.creator }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %} · <a href="{{ creators[0].licenseUrl }}" target="_blank" rel="noopener">{{ creators[0].license }}</a></p>
        {% endif %}
        {% if shown.length < 3 %}
        <p class="images-missing">{% if shown.length %}Flere bilder trengs. {% else %}Ingen bilder ennå. {% endif %}Har du bilder herfra? <a href="{{ site.suggestChangeUrl }}?template=endring.yml&title={{ ('Bilder: ' ~ name) | urlencode }}&site={{ id | urlencode }}" target="_blank" rel="noopener">Send dem inn{{ m.external() }}</a></p>
        {% endif %}
      </section>
      {# 9. Logg og mer #}
      <section class="block block--log" aria-labelledby="h-log">
        <h2 id="h-log">Logg og mer</h2>
        {% if external.flightlog_id %}
        <a class="big-btn big-btn--dark" href="https://flightlog.org/fl.html?l=1&a=22&country_id=160&start_id={{ external.flightlog_id }}" target="_blank" rel="noopener">{{ name }} på Flightlog{{ m.external() }}</a>
        {% else %}
        <span class="big-btn big-btn--empty">Ikke koblet til Flightlog ennå</span>
        {% endif %}
        {# De fleste stedene finnes ikke på Paraglidingearth, så uten kobling vises ingenting. #}
        {% if external.pgearth_id %}
        <a class="big-btn" href="https://www.paraglidingearth.com/?site={{ external.pgearth_id }}" target="_blank" rel="noopener">{{ name }} på Paraglidingearth{{ m.external() }}</a>
        {% endif %}
        {#- Andre lenker for stedet (links i stedsfilen), for eksempel alpinsenteret med åpningstider for heisen. -#}
        {% for l in links %}
        <a class="big-btn big-btn--two-line" href="{{ l.url }}" target="_blank" rel="noopener"><span>{{ l.title }}{% if l.text %}<small>{{ l.text }}</small>{% endif %}</span>{{ m.external() }}</a>
        {% endfor %}
      </section>
    </div>

    {# 10. Bunn #}
  <footer class="page-footer">
    <a class="btn btn--white" href="{{ site.suggestChangeUrl }}?template=endring.yml&title={{ ('Endring: ' ~ name) | urlencode }}&site={{ id | urlencode }}" target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z"></path></svg>Foreslå endring{{ m.external() }}</a>
    <dl class="metadata">
      <dt>Sist endret</dt>
      <dd>{% if derived.lastModified %}{{ derived.lastModified.date | formatDate }}{% if derived.lastModified.name %} av {{ derived.lastModified.name }}{% endif %}{% else %}<span class="missing">Ikke registrert i Git ennå</span>{% endif %}</dd>
      <dt>Gjennomgått</dt>
      <dd>{% if notReviewed %}<strong class="danger">Ikke gjennomgått ennå</strong>{% else %}{{ reviewed.date | formatDate }} av {{ reviewed.by }}{% endif %}</dd>
      <dt>Kilder</dt>
      <dd>{{ derived.sources }}</dd>
    </dl>
    <p class="disclaimer">Opplysningene er veiledende, og hver pilot vurderer selv om stedet og forholdene er OK.</p>
  </footer>
</div>
  </div>
</div>

<script type="application/json" id="site-data">{{ {
  name: name,
  launch: launch,
  launches: launches,
  wind_directions: wind_directions,
  landings: landings,
  parking: parking,
  routes: derived.routes,
  drawing: derived.drawing
} | json | safe }}</script>
{#- Varselet for denne starten, til «vind nå» i Vær (site-wind.js). Bare dette stedet, så siden holder seg liten. -#}
{% if forecast and forecast.sites and forecast.sites[id] %}
<script type="application/json" id="site-wind-data">{{ {
  fetched: forecast.fetched,
  times: forecast.times,
  series: forecast.sites[id],
  rules: windRules,

---
layout: base.njk
map: true
noAddressDetection: true
bodyClass: page-site
scripts:
  - /assets/leaflet-markercluster/leaflet.markercluster.js
  - /assets/js/wind.js
  - /assets/js/stations.js
  - /assets/js/site.js
  - /assets/js/site-wind.js
  - /assets/js/windgram.js
  - /assets/js/lightbox.js
---
{%- import "macros.njk" as m with context -%}
{%- set routes = derived.routes -%}
{%- set notReviewed = not (reviewed and reviewed.by and reviewed.date) -%}
{#- The text in the page's language: the translation (index.en.md etc.) when it exists, otherwise the Norwegian. The fields
    in local are the site file's texts with the translation laid over them (lib/translations.js). -#}
{%- set local = derived.local -%}
{%- set body = derived.translation.html if derived.translation else content -%}
{%- set untranslated = lang != "nb" and not derived.translation -%}
{%- set intro = body | section("intro") -%}
<div class="site-page site-v2">
  {#- The logo at the top left as on the home page, so the site is recognised, and «‹ Alle flysteder» on the image below. -#}
  <header class="topbar">
    <a class="logo" href="{{ '/' | localeUrl }}"><img src="{{ '/assets/img/icon.svg' | url }}" width="28" height="28" alt="">{{ t.common.siteTitle }}</a>
    <div class="topbar__end">{{ m.siteMenu() }}</div>
  </header>

  {#- Hero: the site's first overview image with the name and key facts on top. Without an image, a calm gradient. -#}
  {%- set heroImage = null -%}
  {%- for img in derived.images %}{% if not heroImage and img.field == "overview" %}{% set heroImage = img %}{% endif %}{% endfor %}
  <section class="hero{% if not heroImage %} hero--plain{% endif %}" aria-labelledby="site-name">
    <a class="hero__back" href="{{ '/' | localeUrl }}">{{ m.chevron("left") }}{{ t.common.allSites }}</a>
    {% if heroImage %}<img class="hero__img" src="{{ heroImage.fullUrl }}" srcset="{{ heroImage.srcsetWebp }}" sizes="(min-width: 1100px) 1120px, (min-width: 800px) 760px, 100vw" alt="" fetchpriority="high">{% endif %}
    {#- The directions the site suits, on the image, so they are seen first. Only the site's own directions: the wind now
        is in «Kan jeg fly her nå?» right below. -#}
    {% if wind_directions.primary.length %}<div class="hero__rose">{{ m.rose(wind_directions, 104) }}</div>{% endif %}
    <div class="hero__text">
      {% if region %}<span class="hero__eyebrow">{{ region }}</span>{% endif %}
      <h1 id="site-name">{{ name }}</h1>
      <ul class="hero__chips" aria-label="{{ t.site.keyFacts }}">
        {#- The assessment now from «Kan jeg fly her nå?» (site-wind.js), so it is seen first. Links down to the box. -#}
        <li class="hero__status" id="hero-status" hidden><a href="#vaer"><span class="hero__status-icon" aria-hidden="true"></span><span class="hero__status-text"></span></a></li>
        {% if elevation and elevation.launch_masl %}<li>{{ elevation.launch_masl }} {{ t.units.masl }}</li>{% endif %}
        {% if elevation and elevation.difference_m %}<li>{{ t.site.heightDown | fmt({ m: elevation.difference_m }) }}</li>{% endif %}
        {% if level %}<li>{{ level }}</li>{% else %}<li class="hero__chip--muted">{{ t.site.levelNotSet }}</li>{% endif %}
        {% if categories.length %}<li>{{ categories | join(" · ") }}</li>{% endif %}
        {% if training_site %}<li>{{ t.common.trainingSite }}</li>{% endif %}
        {% if season %}<li>{{ local.season }}</li>{% endif %}
        {% if notReviewed %}<li class="hero__chip--warn">{{ t.common.notReviewed }}</li>{% endif %}
      </ul>
    </div>
  </section>
  {#- Links to the parts of the page in a row right under the image, which stays at the top while scrolling. The part in view
      is marked (site.js). Outside <main>, so it can stay at the top of the whole page, also in the two columns on desktop. -#}
  <nav class="section-nav" aria-label="{{ t.site.sectionNav }}">
    <a href="#vaer">{{ t.site.navNow }}</a>
    <a href="#h-hazards">{{ t.site.hazardsTitle }}</a>
    <a href="#h-launch">{{ t.site.launchAndLanding }}</a>
    <a href="#h-access">{{ t.site.access }}</a>
    <a href="#h-images">{{ t.site.images }}</a>
    <a href="#h-log">{{ t.site.linksTitle }}</a>
  </nav>
  {#- Desktop: two columns under the image. Left: the introduction and «Kan jeg fly her nå?», then Start og landing and
      Adkomst. Right: «Før du starter» (hazards and airspace) beside them, then Bilder and Lenker. The HTML order is the mobile order,
      so screen readers and the keyboard follow what is seen. -#}
  <main class="site-page__body" id="content" tabindex="-1">
    <div class="site-page__top">
    {% if untranslated %}<p class="translation-note" lang="{{ lang }}">{{ t.site.notTranslated }}</p>{% endif %}
    {% if intro %}<div class="lead"{% if untranslated %} lang="nb"{% endif %}>{{ intro | safe }}</div>{% endif %}
    {#- «Kan jeg fly her nå?»: the assessment now in large type, the next 12 hours as cards, and folded below the periods that
        may work and the next 48 hours as bars (site-wind.js). The details (Yr meteogram and winds aloft) are folded too. -#}
    <section class="block block--now{% if forecast and forecast.sites and forecast.sites[id] %} block--now-wait{% endif %}" id="vaer" aria-labelledby="h-weather">
      <h2 id="h-weather" class="now-eyebrow">{{ t.site.canIFly }}</h2>
      <div class="site-wind" id="site-wind" aria-live="polite" hidden></div>
      {#- Scrolls sideways when the cards do not fit, so it can take focus and be scrolled with the arrow keys. -#}
      <ol class="hour-cards" id="hour-cards" aria-label="{{ t.site.next12 }}" tabindex="0" hidden></ol>
      <p class="hour-cards__key" id="hour-cards-key" hidden>{{ t.site.hourCardsKey }}</p>
      {% if wind_limits and wind_limits.max_wind %}<p class="now-limit">{{ t.site.siteMaxWind | fmt({ m: wind_limits.max_wind }) }}</p>{% endif %}
      <details class="fold now-48" id="now-48" hidden>
        <summary><h3>{{ t.site.next48 }}</h3></summary>
        <ul class="wind-windows" id="wind-windows"></ul>
        <div class="wind-chart" id="wind-chart"></div>
      </details>
      <details class="fold now-details">
        <summary><h3>{{ t.site.weatherDetails }}</h3></summary>
        {% if external.yr_id %}
        <figure class="meteogram">
          {#- Yr shows the meteogram in the same language as the page (nb/en in the URL). -#}
          <a href="{{ t.site.yrBase }}{{ external.yr_id }}" target="_blank" rel="noopener"><span class="visually-hidden">{{ t.site.yrForecast }} {{ t.common.opensNewTab }}</span><img src="{{ t.site.meteogramBase }}{{ external.yr_id }}/meteogram.svg" data-src-dark="{{ t.site.meteogramBase }}{{ external.yr_id }}/meteogram.svg?mode=dark" alt="{{ t.site.meteogramAlt | fmt({ name: name }) }}" loading="lazy"></a>
          <figcaption>{{ t.site.meteogramCaption }}</figcaption>
        </figure>
        {% else %}
        <div class="placeholder placeholder--short">{{ t.site.noYr | fmt({ name: name }) }}</div>
        {% endif %}
        {% if windgram and windgram.sites and windgram.sites[id] %}
        <div class="windgram">
          <h3>{{ t.site.windgramTitle }}</h3>
          <p class="muted">{{ t.site.windgramIntro }}</p>
          <div class="windgram__scroll" id="windgram-grid" tabindex="0" role="region" aria-label="{{ t.site.windgramTitle }}" hidden></div>
          <p class="windgram__source">{{ t.site.windgramSource | safe }}</p>
        </div>
        {% endif %}
      </details>
    </section>
    </div>
    {#- The weather station on this flying site, when it has one: the wind measured now, with a link to the station
        (stations.js; the stations and their sites are in workers/data/src/stations.js). Right after «Kan jeg fly her nå?»
        on mobile; on desktop site.js moves it to the top of the right column (under «Før du starter»), where the chart is
        not too big. -#}
    <section class="block block--station station-now" id="station-now" aria-label="{{ t.home.stationsTitle }}" data-url="{{ site.stationsUrl }}" data-site="{{ id }}" hidden></section>
    <section class="block block--notice{% if not local.hazards.length %} block--notice-empty{% endif %}" aria-labelledby="h-hazards">
      <h2 id="h-hazards"><span class="notice-icon" aria-hidden="true">!</span>{{ t.site.hazardsTitle }}</h2>
      {% for hazard in local.hazards %}
      <div class="hazard"{% if untranslated %} lang="nb"{% endif %}>
        <strong>{{ hazard.title }}</strong>
        <span>{{ hazard.text }}</span>
      </div>
      {% else %}
      {#- If not reviewed, an empty list only means nobody has entered hazards, not that there are none. -#}
      {% if notReviewed %}
      <p>{{ t.site.hazardsNotReviewed | safe }}</p>
      {% else %}
      <p>{{ t.site.hazardsNone }}</p>
      {% endif %}
      {% endfor %}
      {#- The airspace over the launch belongs here too: the lowest fixed airspace above it, with the height profile, and notes
          about nearby airspace. One box with what to watch out for, as in «Pass på» in the v3 prototype. -#}
      <h3 class="notice-sub" id="h-airspace">{{ t.site.airspace }}</h3>
    <div class="airspace">
          {% if derived.airspace %}
          {#- Fetched automatically from openAIP (npm run airspace). Shows only the ceiling above launch: the lowest fixed
              airspace above the launch site. Names from the site file's airspace override when type and lower limit match. -#}
          {% set ceiling = derived.airspaceCeiling %}
          {% if ceiling %}
          {% set a = ceiling.airspace %}
          {#- The figure shows the name, class and floor. Airspace from the ground has no figure, so it is said in text. -#}
          {% if ceiling.fromGround %}<p class="airspace__ground"><strong>{{ a.name }}</strong>{% if a["class"] %} · {{ t.site.class | fmt({ c: a["class"] }) }}{% endif %}: {{ t.site.fromGround }}</p>{% endif %}
          {#- Terrain, launch, landing and the airspace floor, with the height over the launch (lib/airspace-profile.js).
              Only fixed airspace: areas activated by NOTAM are not part of the ceiling. -#}
          {{ ceiling | airspaceProfile(elevation.launch_masl, elevation.landing_masl) | safe }}
          {% if a.note %}<span class="muted">{{ a.note }}</span>{% endif %}
          {% else %}
          <span class="muted">{{ t.site.noAirspace }}</span>
          {% endif %}
          {#- Nearby airspace is only shown when the site file has a note about it, for example that the approach
              to the landing enters Evenes CTR. -#}
          {% for n in derived.airspace.airspaces %}{% if n.note and not (ceiling and n.name == ceiling.airspace.name) %}
          <span class="muted airspace__nearby"><strong>{{ n.name }}</strong>{% if not n.overLaunch %} ({{ t.site.kmAway | fmt({ km: n.distanceKm | replace(".", t.meta.decimal) }) }}){% endif %}: {{ n.note }}</span>
          {% endif %}{% endfor %}
          <span class="airspace__source">{{ t.site.airspaceSource | fmt({ date: derived.airspace.fetched | formatDate }) }} {{ t.site.checkIppc | fmt({ ippc: '<a href="https://ippc.no" target="_blank" rel="noopener">IPPC' ~ m.external() ~ '</a>' }) | safe }} <a href="{{ '/tarn/' | localeUrl }}">{{ t.site.towerPhones }}</a></span>
          {% else %}
          {% set mainAirspace = local.airspace | rejectattr("nearby") | list %}
          {% for a in mainAirspace %}
          <span class="tags">
            {{ m.tag(a.name) }}
            {% if a["class"] %}{{ m.tag(t.site.class | fmt({ c: a["class"] })) }}{% endif %}
            {% if a.lower and a.lower.unit == "FT" %}{{ m.tag(t.site.lowerFt | fmt({ value: a.lower.value })) }}{% if a.lower.ref == "MSL" %}{{ m.tag(t.site.aboutMasl | fmt({ m: a.lower.value | feetToMeters })) }}{% endif %}
            {% elif a.lower and a.lower.unit == "FL" %}{{ m.tag(t.site.lowerFl | fmt({ value: a.lower.value })) }}{% endif %}
          </span>
          {% if a.note %}<span class="muted">{{ a.note }}</span>{% endif %}
          {% endfor %}
          {% if not mainAirspace.length %}<span class="missing">{{ t.site.airspaceMissing | fmt({ ippc: '<a href="https://ippc.no" target="_blank" rel="noopener">IPPC' ~ m.external() ~ '</a>' }) | safe }}</span>{% endif %}
          {% endif %}
        </div>
    </section>

    <div class="site-page__main">
      {#- Start og landing: the map with launch, direction arcs, points, landing, parking and walking route first, then the launch
          and the landing in words. -#}
      <section class="block block--launch" aria-labelledby="h-launch">
        <h2 id="h-launch">{{ t.site.launchAndLanding }}</h2>
        <div id="site-map" class="map map--site" role="region" aria-label="{{ t.site.mapLabel | fmt({ name: name }) }}"></div>
        <ul class="map-legend" aria-label="{{ t.site.mapLegend }}">
          <li><span class="map-symbol map-symbol--launch-dot"></span>{{ t.site.launch }}</li>
          {% if landings.length %}<li><span class="map-symbol map-symbol--landing"></span>{{ t.site.landing }}</li>{% endif %}
          {#- Other landings with their own name (for example «SPG-landing») are shown by name, otherwise «Alternativ landing». -#}
          {% for l in local.landings | rejectattr("primary") %}{% if l.name and l.name != "Landing" %}<li><span class="map-symbol map-symbol--landing map-symbol--alt"></span>{{ l.name }}</li>{% elif loop.first %}<li><span class="map-symbol map-symbol--landing map-symbol--alt"></span>{{ t.site.altLanding }}</li>{% endif %}{% endfor %}
          {% if parking.length %}<li><span class="symbol symbol--parking">P</span>{{ t.site.parking }}</li>{% endif %}
          {% if routes.length %}<li><span class="symbol symbol--route"></span>{{ t.site.route }}</li>{% endif %}
          {% if wind_directions.primary.length %}<li><span class="symbol drawing-swatch drawing-swatch--arrow"></span>{{ t.site.suitedDirections }}</li>{% endif %}
          {% if wind_directions.possible.length %}<li><span class="symbol drawing-swatch drawing-swatch--possible"></span>{{ t.site.possibleDirection }}</li>{% endif %}
          {%- set hasPins = false %}{% set hasHazard = false %}
          {%- if derived.drawing %}{% for f in derived.drawing.features %}{% if f.properties.kind == "label" %}{% set hasPins = true %}{% if f.properties.style == "hazard" %}{% set hasHazard = true %}{% endif %}{% endif %}{% endfor %}{% endif %}
          {% if hasPins %}<li><span class="drawing-pin drawing-pin--legend">1</span>{{ t.site.pointLegend }}</li>{% endif %}
          {% if hasHazard %}<li><span class="drawing-pin drawing-pin--hazard drawing-pin--legend">!</span>{{ t.site.hazard }}</li>{% endif %}
        </ul>
        {% if not parking.length %}<p class="missing">{{ t.site.parkingMissing }}</p>{% endif %}
        {#- Points from the drawing (<id>-drawing.geojson), with the same numbers as in the map (site.js). -#}
        {%- set points = [] -%}
        {%- if derived.drawing %}{% for f in derived.drawing.features %}{% if f.properties.kind == "label" and f.properties.title %}{% set points = (points.push(f), points) %}{% endif %}{% endfor %}{% endif %}
        {% if points.length %}
        <details class="fold points" data-fold-mobile open>
          <summary><h3>{{ t.site.pointsTitle }}</h3></summary>
          <ol class="drawing-list">
            {% for f in points %}
            <li data-n="{{ loop.index }}">
              <button type="button" data-n="{{ loop.index }}" aria-label="{{ t.site.showPoint | fmt({ n: loop.index }) }}"><span class="drawing-pin{% if f.properties.style == 'hazard' %} drawing-pin--hazard{% endif %}">{{ loop.index }}</span></button>
              <div><strong>{{ f.properties.title }}</strong>{% if f.properties.text %}<span>{{ f.properties.text }}</span>{% endif %}</div>
            </li>
            {% endfor %}
          </ol>
        </details>
        {% endif %}
        <h3 id="h-launch-text">{{ t.site.launch }}</h3>
        <div class="launch-head">
          {{ m.rose(wind_directions, 120) }}
          <div class="launch-head__text">
            {{ m.legend(wind_directions) }}
          </div>
        </div>
        {% set launchText = body | section([t.site.launch, "Start"]) %}
        {% if launchText %}<div class="prose"{% if untranslated %} lang="nb"{% endif %}>{{ launchText | safe }}</div>{% endif %}
        {% if launches.length %}
        {#- Category (PG/SPG) in its own column between the directions and the text, only when some launch has a category. -#}
        {%- set hasLaunchCategories = false -%}
        {%- for group in derived.launchGroups %}{% if group.categories.length %}{% set hasLaunchCategories = true %}{% endif %}{% endfor %}
        {#- Folded on mobile (site.js), so the page is shorter: the rose and the text above give the overview. Open on desktop. -#}
        <details class="fold launch-fold" data-fold-mobile open>
        <summary><h4>{{ t.site.launchesLabel }} ({{ derived.launchGroups.length }})</h4></summary>
        <ul class="launch-list{% if hasLaunchCategories %} launch-list--categories{% endif %}" aria-label="{{ t.site.launchesLabel }}">
          {#- Launches with the same directions are merged into one line (groupLaunches in sites.11tydata.js). -#}
          {% for group in derived.launchGroups %}
          <li data-dirs="{{ group.directions | join(' ') }}">
            <span class="launch-list__badges">
              {% for code in group.directions %}{{ m.directionBadge(code, wind_directions) }}{% endfor %}
            </span>
            {% if hasLaunchCategories %}<span class="launch-list__categories">{% for c in group.categories %}{{ m.tag(c) }}{% endfor %}</span>{% endif %}
            <span class="launch-list__texts">{% for t in group.texts %}<span>{{ t }}</span>{% endfor %}</span>
          </li>
          {% endfor %}
        </ul>
        </details>
        {% endif %}
        <h3 id="h-landing">{{ t.site.landing }}</h3>
        {%- set mainLanding = (local.landings | selectattr("primary") | first) or local.landings[0] -%}
        {% if mainLanding and elevation and elevation.difference_m %}
        {%- set glideKm = launch | distanceKm(mainLanding) -%}
        <p class="glide"><span class="glide__label">{{ t.site.glide }}</span> <strong>{{ t.site.glideText | fmt({ km: glideKm | formatNumber(1), m: elevation.difference_m, ratio: (glideKm * 1000 / elevation.difference_m) | formatNumber(1) }) }}</strong></p>
        {% endif %}
        {% set landingText = body | section([t.site.landing, "Landing"]) %}
        {% if landingText %}<div class="prose"{% if untranslated %} lang="nb"{% endif %}>{{ landingText | safe }}</div>{% else %}<p class="missing">{{ t.site.noLandingText }}</p>{% endif %}
        {#- Applies to all sites, so it is in the template and not in each site file. -#}
        <p class="landing-note">{{ t.site.landingNote }}</p>
      </section>

      {#- Adkomst: the way up, with the walking route as numbers and elevation profile, parking, and directions and GPX. -#}
      <section class="block block--landing" aria-labelledby="h-access">
        <h2 id="h-access">{{ t.site.access }}</h2>
        {#- Access as numbers when the site has one walking route: length, elevation gain and walking time. -#}
        {% set oneRoute = routes[0] if routes.length == 1 else null %}
        {% if oneRoute %}
        <div class="access-stats" role="group" aria-label="{{ t.site.routeStats }}">
          <div><strong>{{ oneRoute.lengthKm | formatNumber(1) }}</strong> <span>{{ t.site.km }}</span><small>{{ t.site.route }}</small></div>
          {% if oneRoute.elevationGain %}<div><strong>{{ (oneRoute.elevationGain / 10) | round * 10 }}</strong> <span>m</span><small>{{ t.site.climb }}</small></div>{% endif %}
          {% if oneRoute.walkTimeMin %}<div><strong>{{ oneRoute.walkTimeMin }}</strong> <span>{{ t.units.minutes }}</span><small>{{ t.site.onFoot }}</small></div>{% endif %}
        </div>
        {% endif %}
        {#- The elevation profile of the walking route, open and near the top, since the way up is what the part is mostly about.
            The slider shows the position in the map above. -#}
        {% if routes | selectattr("profile") | list | length %}
        <details class="fold profile-fold" open>
          <summary><h3>{{ t.site.profile }}</h3></summary>
          <div class="profile" id="elevation-profile">
          {% if routes.length > 1 %}
          <div class="pills" role="tablist" aria-label="{{ t.site.chooseRoute }}">
            {% for r in routes %}
            <button type="button" class="pill" role="tab" data-route="{{ loop.index0 }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ (r.name or (t.site.routeN | fmt({ n: loop.index }))) | capitalizeFirst }}</button>
            {% endfor %}
          </div>
          {% endif %}
          <svg class="profile__graph" viewBox="0 0 350 150" preserveAspectRatio="none" role="img" aria-label="{{ t.site.profileLabel }}"></svg>
          <input class="profile__slider" type="range" min="0" max="1" value="0" aria-label="{{ t.site.profilePosition }}">
          <div class="profile__values" aria-live="polite">
            <span><span class="muted">{{ t.site.distance }} </span><strong data-readout="distance">0 km</strong></span>
            <span><span class="muted">{{ t.site.elevation }} </span><strong data-readout="elevation"></strong></span>
            <span><span class="muted">{{ t.site.grade }} </span><strong data-readout="grade"></strong></span>
          </div>
          <div class="profile__legend"><span class="stroke-swatch"></span>{{ t.site.steeper }}</div>
          <p class="profile__summary"></p>
          </div>
        </details>
        {% endif %}
        <dl class="row-list">
          <div>
            <dt>{{ t.site.parking }}</dt>
            {#- Parking in the map without a description is not «ikke registrert»: it is then only shown in the map. -#}
            <dd>{% if local.access.parking_text %}{{ local.access.parking_text }}{% elif parking and parking.length %}{{ t.site.parkingInMap }} <span class="missing">{{ t.site.descriptionMissing }}</span>{% else %}<span class="missing">{{ t.common.notRegistered }}</span>{% endif %}</dd>
          </div>
          <div>
            <dt>{{ t.site.wayUp }}</dt>
            <dd>
              {% if local.access.route_text %}{{ local.access.route_text }}{% elif oneRoute %}{{ t.site.followRoute }}{% elif not routes.length %}<span class="missing">{{ t.common.notRegistered }}</span>{% endif %}
              {% for r in routes if not oneRoute %}
              <span class="route-stats">{% if routes.length > 1 %}{{ (r.name or (t.site.routeN | fmt({ n: loop.index }))) | capitalizeFirst }}: {% else %}{{ t.site.routeLabel }}{% endif %}{{ (t.site.routeLengthClimb if r.elevationGain else t.site.routeLength) | fmt({ km: r.lengthKm | formatNumber(1), gain: (r.elevationGain / 10) | round * 10 }) }}</span>
              {% endfor %}
            </dd>
          </div>
          {% if not (oneRoute and oneRoute.walkTimeMin) %}
          <div>
            <dt>{{ t.site.time }}</dt>
            <dd>
              {% set hasTime = (routes | selectattr("walkTimeMin") | list | length) or (not routes.length and access.walk_time_min) %}
              {% for r in routes %}{% if r.walkTimeMin %}
              <span class="route-stats">{% if routes.length > 1 %}{{ (r.name or (t.site.routeN | fmt({ n: loop.index }))) | capitalizeFirst }}: {% endif %}{{ t.site.minutesOnFoot | fmt({ min: r.walkTimeMin }) }}</span>
              {% endif %}{% endfor %}
              {% if not routes.length and access.walk_time_min %}{{ t.site.minutesOnFoot | fmt({ min: access.walk_time_min }) }}{% endif %}
              {% if not hasTime %}<span class="missing">{{ t.common.notRegistered }}</span>{% endif %}
            </dd>
          </div>
          {% endif %}
        </dl>
        <div class="buttons">
          {% for p in local.parking %}
          <a class="btn btn--primary" href="https://www.google.com/maps/dir/?api=1&destination={{ p.lat }},{{ p.lon }}" target="_blank" rel="noopener">{{ m.icon("directions") }}{{ t.site.directionsTo | fmt({ target: t.site.directionsParking if parking.length == 1 else p.name }) }}{{ m.external() }}</a>
          {% endfor %}
          {% for r in routes %}
          <a class="btn" href="{{ r.url }}" download>{{ m.icon("download") }}{{ t.site.downloadRoute | fmt({ name: (" " ~ (r.name or loop.index)) if routes.length > 1 else "" }) }}</a>
          {% endfor %}
        </div>
      </section>
    </div>
    <div class="site-page__aside">

      {#- 8. Images: the first overview image (aerial, from the landing towards launch, or the view from launch) large at the top
          (same as the preview image when the page is shared), the first launch and first landing image below. If the site
          has more images, «Se alle N bilder» opens the lightbox with all of them, in the order overview, launch, landing.
          If some types are missing, only those that exist are shown, plus one line about submitting images. -#}
      {%- set shown = derived.images | selectattr("featured") | list -%}
      {%- set extra = derived.images | rejectattr("featured") | list -%}
      <section class="block block--images" aria-labelledby="h-images">
        <details class="fold" data-fold-mobile open>
        <summary><h2 id="h-images">{{ t.site.images }}</h2></summary>
        {% if shown.length %}
        <div class="image-grid">
          {% for image in shown %}
          <figure>
            {{ m.lightboxLink(image, image.caption) }}
            <figcaption>{{ image.caption }}</figcaption>
          </figure>
          {% endfor %}
        </div>
        {% endif %}
        {% if extra.length %}
        {#- The button is shown by lightbox.js. Without JavaScript only the images above exist. -#}
        <button type="button" class="big-btn images-all" data-lightbox-all hidden><span>{{ t.site.seeAllImages | fmt({ n: derived.images.length }) }}</span></button>
        {% for image in extra %}{{ m.lightboxLink(image, image.caption, false) }}{% endfor %}
        {% endif %}
        {#- The photographers and the licence, once per photographer. Also in the image metadata and the lightbox. -#}
        {%- set creators = [] -%}{%- set creatorNames = [] -%}
        {%- for image in derived.images %}{% if image.credit and not (image.credit.creator in creatorNames) %}{% set creatorNames = (creatorNames.push(image.credit.creator), creatorNames) %}{% set creators = (creators.push(image.credit), creators) %}{% endif %}{% endfor %}
        {% if creators.length %}
        <p class="images-credit">{{ t.site.photo }}: {% for c in creators %}{% if c.url %}<a href="{{ c.url }}" target="_blank" rel="noopener">{{ c.creator }}</a>{% else %}{{ c.creator }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %} · <a href="{{ creators[0].licenseUrl }}" target="_blank" rel="noopener">{{ creators[0].license }}</a></p>
        {% endif %}
        {#- Sending in photos goes through a form without a GitHub account once it exists. Until then only that there are none. -#}
        {% if not shown.length %}<p class="images-missing">{{ t.site.noImages }}</p>{% endif %}
        </details>
      </section>
      {# 9. Log and more #}
      {#- Links: the weather for this launch (Yr and Windy; Flybart covers only a few stations and is on the home page), the flight log and the site's own links (links in the site file, for
          example the ski resort with lift opening hours). In the right column on desktop. -#}
      <section class="block block--log" aria-labelledby="h-log">
        <details class="fold" data-fold-mobile open>
        <summary><h2 id="h-log">{{ t.site.linksTitle }}</h2></summary>
        <div class="link-group">
        <h3 class="link-group__title">{{ t.site.linksWeather }}</h3>
        <div class="now-links">
          {% if external.yr_id %}<a class="btn" href="{{ t.site.yrBase }}{{ external.yr_id }}" target="_blank" rel="noopener">{{ m.icon("cloud") }}Yr{{ m.external() }}</a>{% endif %}
          <a class="btn" href="https://www.windy.com/{{ launch.lat }}/{{ launch.lon }}?{{ launch.lat }},{{ launch.lon }},12" target="_blank" rel="noopener">{{ m.icon("wind") }}Windy{{ m.external() }}</a>
          {#- The site's weather station at Holfuy, shown by stations.js when the site has one. -#}
          <a class="btn" id="station-link" href="https://holfuy.com/" target="_blank" rel="noopener" hidden>{{ m.icon("wind") }}Holfuy{{ m.external() }}</a>
        </div>
        </div>
        <div class="link-group">
        <h3 class="link-group__title">{{ t.site.linksLog }}</h3>
        {% if external.flightlog_id %}
        <a class="big-btn big-btn--dark" href="https://flightlog.org/fl.html?l=1&a=22&country_id=160&start_id={{ external.flightlog_id }}" target="_blank" rel="noopener">{{ m.icon("log") }}<span>{{ t.site.onFlightlog | fmt({ name: name }) }}</span>{{ m.external() }}</a>
        {% else %}
        <span class="big-btn big-btn--empty">{{ t.site.noFlightlog }}</span>
        {% endif %}
        </div>
        {% if local.links.length %}
        <div class="link-group">
        <h3 class="link-group__title">{{ t.site.linksMore }}</h3>
        {% for l in local.links %}
        <a class="big-btn big-btn--two-line" href="{{ l.url }}" target="_blank" rel="noopener">{{ m.icon("link") }}<span>{{ l.title }}{% if l.text %}<small>{{ l.text }}</small>{% endif %}</span>{{ m.external() }}</a>
        {% endfor %}
        </div>
        {% endif %}
        </details>
      </section>
    </div>
    {# Footer #}
  <footer class="page-footer">
    <dl class="metadata">
      <dt>{{ t.site.lastModified }}</dt>
      <dd>{% if derived.lastModified %}{{ derived.lastModified.date | formatDate }}{% if derived.lastModified.name %} {{ t.site.by }} {{ derived.lastModified.name }}{% endif %}{% else %}<span class="missing">{{ t.site.notInGit }}</span>{% endif %}</dd>
      <dt>{{ t.site.reviewed }}</dt>
      <dd>{% if notReviewed %}<strong class="danger">{{ t.common.notReviewed }}</strong>{% else %}{{ reviewed.date | formatDate }} {{ t.site.by }} {{ reviewed.by }}{% endif %}</dd>
      <dt>{{ t.site.sources }}</dt>
      {#- The source names on one line, and what each field comes from folded below, for those who want to check. -#}
      <dd>{{ derived.sourcesShort }}{% if derived.sources %} <details class="sources-details"><summary>{{ t.site.sourcesDetails }}</summary>{{ derived.sources }}</details>{% endif %}</dd>
    </dl>
    <p class="disclaimer">{{ t.site.footerDisclaimer }} <a href="{{ '/om/' | localeUrl }}">{{ t.common.aboutLink }}</a></p>
  </footer>
  </main>
  {#- Mobile: the three things you need on the way, always at the bottom of the screen. -#}
  <nav class="action-bar" aria-label="{{ t.site.quickActions }}">
    {% if parking.length %}<a class="action-bar__primary" href="https://www.google.com/maps/dir/?api=1&destination={{ parking[0].lat }},{{ parking[0].lon }}" target="_blank" rel="noopener">{{ m.icon("directions") }}{{ t.site.directions }}</a>{% endif %}
    <a href="#site-map">{{ m.icon("map") }}{{ t.site.map }}</a>
    {% if routes.length %}<a href="{{ routes[0].url }}" download>{{ m.icon("download") }}GPX</a>{% endif %}
  </nav>
</div>

<script type="application/json" id="site-data">{{ {
  name: name,
  launch: launch,
  launches: local.launches,
  wind_directions: wind_directions,
  landings: local.landings,
  parking: local.parking,
  routes: derived.routes,
  drawing: derived.drawing
} | json | safe }}</script>
{% if windgram and windgram.sites and windgram.sites[id] %}
{%- set wg = windgram.sites[id] -%}
<script type="application/json" id="windgram-data">{{ {
  fetched: windgram.fetched, lat: launch.lat, lon: launch.lon,
  times: wg.times, heights: wg.heights, launch: wg.launch, cells: wg.cells, blh: wg.blh, cloudBase: wg.cloudBase,
  rules: { minWind: windRules.minWind, maxWind: (wind_limits.max_wind if wind_limits and wind_limits.max_wind else windRules.maxWind), maxGust: windRules.maxGust }
} | json | safe }}</script>
{% endif %}
{#- The forecast for this launch, for «vind nå» in Vær (site-wind.js). Only this site, so the page stays small. -#}
{% if forecast and forecast.sites and forecast.sites[id] %}
<script type="application/json" id="site-wind-data">{{ {
  fetched: forecast.fetched,
  times: forecast.times,
  series: forecast.sites[id],
  rules: windRules,
  live: site.forecastUrl,
  site: { id: id, lat: launch.lat, lon: launch.lon, primary: wind_directions.primary or [], possible: wind_directions.possible or [], maxWind: (wind_limits.max_wind if wind_limits and wind_limits.max_wind else null) }
} | json | safe }}</script>
{% endif %}
